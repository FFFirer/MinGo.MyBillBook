@implements IDisposable

<div class="fixed inset-y-0 left-0 z-50 w-64 bg-surface-container-low transform lg:translate-x-0 transition-transform duration-300 ease-out
            @(IsOpen ? "translate-x-0" : "-translate-x-full")
            flex flex-col"
     id="sidebar"
     style="padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px);"
     aria-hidden="@(!IsOpen)">

    @* MD3 Navigation drawer 头部：不使用 primary 色，仅 surface-container-low 底 *@
    <div class="flex items-center justify-between h-16 px-4 shrink-0">
        <div class="flex items-center min-w-0">
            <span class="material-symbols-outlined text-primary mr-3 shrink-0" style="font-size:1.5rem;">account_balance_wallet</span>
            <span class="text-title-large text-on-surface truncate">个人财务分析</span>
        </div>
        @* 移动端关闭按钮 *@
        <button type="button"
                class="md-icon-btn drawer-close shrink-0"
                aria-label="关闭导航菜单"
                @onclick="OnClose">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>

    <nav class="flex-1 overflow-y-auto overscroll-contain mt-2 px-3 pb-4"
         style="-webkit-overflow-scrolling: touch;">
        <NavLink class="md-nav-item" href="" Match="NavLinkMatch.All" @onclick="OnNavClick">
            <span class="material-symbols-outlined">dashboard</span>
            <span>首页</span>
        </NavLink>

        <NavLink class="md-nav-item" href="import" @onclick="OnNavClick">
            <span class="material-symbols-outlined">upload_file</span>
            <span>导入对账单</span>
        </NavLink>

        <NavLink class="md-nav-item" href="bills" @onclick="OnNavClick">
            <span class="material-symbols-outlined">receipt_long</span>
            <span>账单明细</span>
        </NavLink>

        <NavLink class="md-nav-item" href="analysis" @onclick="OnNavClick">
            <span class="material-symbols-outlined">analytics</span>
            <span>消费分析</span>
        </NavLink>

        <div class="md-divider my-2"></div>

        <NavLink class="md-nav-item" href="platforms" @onclick="OnNavClick">
            <span class="material-symbols-outlined">payment</span>
            <span>支付平台</span>
        </NavLink>

        <NavLink class="md-nav-item" href="accounts" @onclick="OnNavClick">
            <span class="material-symbols-outlined">account_balance</span>
            <span>资金账户</span>
        </NavLink>

        <NavLink class="md-nav-item" href="categories" @onclick="OnNavClick">
            <span class="material-symbols-outlined">category</span>
            <span>消费分类</span>
        </NavLink>

        <NavLink class="md-nav-item" href="merchants" @onclick="OnNavClick">
            <span class="material-symbols-outlined">storefront</span>
            <span>商户归一化</span>
        </NavLink>

        <NavLink class="md-nav-item" href="duplicates" @onclick="OnNavClick">
            <span class="material-symbols-outlined">difference</span>
            <span>去重复核</span>
        </NavLink>

        <NavLink class="md-nav-item" href="tags" @onclick="OnNavClick">
            <span class="material-symbols-outlined">sell</span>
            <span>标签体系</span>
        </NavLink>

        <NavLink class="md-nav-item" href="reconciliation" @onclick="OnNavClick">
            <span class="material-symbols-outlined">account_balance_wallet</span>
            <span>对账中心</span>
        </NavLink>

        <NavLink class="md-nav-item" href="jobs" @onclick="OnNavClick">
            <span class="material-symbols-outlined">build_circle</span>
            <span>任务与重建</span>
        </NavLink>
    </nav>

    @* 桌面端底部主题切换（移动端已在顶栏提供） *@
    <div class="hidden lg:flex items-center justify-between px-4 py-3 border-t border-outline-variant shrink-0">
        <span class="text-label-medium text-on-surface-variant">主题</span>
        <ThemeToggle />
    </div>
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task OnNavClick()
    {
        // 移动端点击导航后自动收起抽屉；桌面端 (lg) 抽屉常驻，无需处理
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    protected override void OnInitialized()
    {
    }

    public void Dispose()
    {
    }
}
