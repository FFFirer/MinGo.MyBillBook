@page "/accounts"
@using System.Net.Http.Json
@using MinGo.MyBillBook.Core.Models
@inject HttpClient Http

<PageTitle>资金账户</PageTitle>
<div class="space-y-4 sm:space-y-6">
    <div class="page-header">
        <h1>资金账户</h1>
        <div class="actions">
            <button @onclick="OpenCreateDialog" class="md-btn-filled state-layer">
                <span class="material-symbols-outlined mr-1 sm:mr-2">add</span>
                <span class="hidden xs:inline">新增账户</span><span class="xs:hidden">新增</span>
            </button>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="bg-error-container text-on-error-container px-4 py-3 rounded-md flex justify-between items-start gap-3" role="alert">
            <span class="flex-1 text-body-medium break-words">@errorMessage</span>
            <button @onclick="() => errorMessage = null" class="md-icon-btn shrink-0" aria-label="关闭">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }

    @if (accounts != null)
    {
        <div class="md-card-elevated overflow-hidden">
            <div class="overflow-x-auto">
                <table class="md-table responsive-cards">
                    <thead>
                        <tr>
                            <th class="text-left">账户名</th>
                            <th class="text-left">平台</th>
                            <th class="text-left hide-mobile">类型</th>
                            <th class="text-right">余额</th>
                            <th class="text-right hide-mobile">银行/计算</th>
                            <th class="text-center hide-mobile">状态</th>
                            <th class="text-right">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in PagedAccounts)
                        {
                            <tr>
                                <td data-label="账户名" class="font-medium text-on-surface wrap-cell"><span class="break-words">@a.Name</span></td>
                                <td data-label="平台" class="text-on-surface-variant">@a.PlatformName</td>
                                <td data-label="类型" class="text-on-surface-variant hide-mobile">@GetAccountTypeName(a.AccountType)</td>
                                <td data-label="余额" class="text-right font-medium tabular-nums text-on-surface">@a.Balance.ToString("F2")</td>
                                <td data-label="银行/计算" class="text-right text-body-small hide-mobile wrap-cell">
                                    @{ var rc = ReconFor(a.Id); }
                                    @if (rc == null)
                                    {
                                        <span class="text-on-surface-variant">未对账</span>
                                    }
                                    else
                                    {
                                        var diff = rc.Difference ?? 0m;
                                        <div class="text-on-surface-variant tabular-nums">银行 @rc.BankBalance?.ToString("F2")</div>
                                        <div class="text-on-surface-variant tabular-nums">计算 @rc.CalculatedBalance?.ToString("F2")</div>
                                        @if (Math.Abs(diff) > 0.01m)
                                        {
                                            <div class="text-error tabular-nums">差异 @diff.ToString("F2")</div>
                                        }
                                    }
                                </td>
                                <td data-label="状态" class="text-center hide-mobile">
                                    <span class="md-chip @(a.IsActive ? "md-chip-assist-success" : "md-chip-assist-info")">
                                        @(a.IsActive ? "活跃" : "停用")
                                    </span>
                                </td>
                                <td data-label="操作" class="text-right">
                                    <div class="inline-flex items-center justify-end gap-1">
                                        <button @onclick="() => OpenEditDialog(a)" class="md-icon-btn" title="编辑" aria-label="编辑 @a.Name">
                                            <span class="material-symbols-outlined">edit</span>
                                        </button>
                                        <button @onclick="() => DeleteAccount(a)" class="md-icon-btn" title="删除" aria-label="删除 @a.Name">
                                            <span class="material-symbols-outlined text-error">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Paginator TotalCount="@(accounts?.Count ?? 0)" PageSize="PageSize" @bind-Page="accountsPage" />
        </div>
    }
</div>

<!-- 删除确认弹窗 -->
@if (confirmDeleteName != null)
{
    <div class="modal-root" @onclick="CancelDelete" role="alertdialog" aria-modal="true" aria-label="确认删除">
        <div class="modal-panel modal-sm" @onclick:stopPropagation>
            <div class="flex items-center mb-4">
                <div class="p-2 rounded-md bg-error-container mr-3 shrink-0">
                    <span class="material-symbols-outlined text-error">warning</span>
                </div>
                <h2 class="text-title-large text-on-surface">确认删除</h2>
            </div>
            <p class="text-body-medium text-on-surface-variant mb-6">确定要删除账户「<strong class="text-on-surface">@confirmDeleteName</strong>」吗？此操作不可撤销。</p>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3">
                <button @onclick="CancelDelete" class="md-btn-outlined state-layer w-full sm:w-auto">取消</button>
                <button @onclick="ConfirmDelete" class="md-btn-danger state-layer w-full sm:w-auto">确认删除</button>
            </div>
        </div>
    </div>
}

<!-- 新增/编辑弹窗 -->
@if (showDialog)
{
    <div class="modal-root" @onclick="CloseDialog" role="dialog" aria-modal="true" aria-label="@(editingId.HasValue ? "编辑账户" : "新增账户")">
        <div class="modal-panel modal-sm" @onclick:stopPropagation>
            <h2 class="text-title-large text-on-surface mb-4">@(editingId.HasValue ? "编辑账户" : "新增账户")</h2>
            <div class="space-y-4">
                <div>
                    <label for="accNameInput" class="block text-body-small text-on-surface-variant mb-1">账户名</label>
                    <input id="accNameInput" @bind="formName" class="md-text-field-outlined w-full" placeholder="如：支付宝余额" />
                </div>
                <div>
                    <label for="accPlatformSelect" class="block text-body-small text-on-surface-variant mb-1">所属平台</label>
                    <select id="accPlatformSelect" @bind="formPlatformId" class="md-text-field-outlined w-full">
                        <option value="0">请选择平台</option>
                        @if (platforms != null)
                        {
                            @foreach (var p in platforms)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label for="accTypeSelect" class="block text-body-small text-on-surface-variant mb-1">账户类型</label>
                    <select id="accTypeSelect" @bind="formAccountType" class="md-text-field-outlined w-full">
                        @foreach (var type in Enum.GetValues<AccountType>())
                        {
                            <option value="@((int)type)">@GetAccountTypeName((int)type)</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="accBalanceInput" class="block text-body-small text-on-surface-variant mb-1">余额</label>
                    <input id="accBalanceInput" @bind="formBalance" type="number" step="0.01" inputmode="decimal" class="md-text-field-outlined w-full" placeholder="0.00" />
                </div>
            </div>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3 mt-6">
                <button @onclick="CloseDialog" class="md-btn-outlined state-layer w-full sm:w-auto">取消</button>
                <button @onclick="SaveAccount" disabled="@isSaving" class="md-btn-filled state-layer w-full sm:w-auto">
                    @(isSaving ? "保存中…" : "保存")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<AccountDto>? accounts;
    private List<PlatformDto>? platforms;
    private List<AccountReconDto>? recon;
    private int accountsPage = 1;
    private const int PageSize = 20;
    private IEnumerable<AccountDto> PagedAccounts => accounts?.Skip((accountsPage - 1) * PageSize).Take(PageSize) ?? [];
    private bool showDialog;
    private int? editingId;
    private int? confirmDeleteId;
    private string? confirmDeleteName;
    private string formName = string.Empty;
    private int formPlatformId;
    private int formAccountType;
    private decimal formBalance;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        accounts = await Http.GetFromJsonAsync<List<AccountDto>>("api/accounts");
        platforms = await Http.GetFromJsonAsync<List<PlatformDto>>("api/platforms");
        recon = await Http.GetFromJsonAsync<List<AccountReconDto>>("api/reconciliation/accounts");
    }

    private AccountReconDto? ReconFor(int accountId) =>
        recon?.FirstOrDefault(r => r.Id == accountId);

    private void OpenCreateDialog()
    {
        editingId = null;
        formName = string.Empty;
        formPlatformId = platforms?.FirstOrDefault()?.Id ?? 0;
        formAccountType = 0;
        formBalance = 0;
        errorMessage = null;
        showDialog = true;
    }

    private void OpenEditDialog(AccountDto a)
    {
        editingId = a.Id;
        formName = a.Name;
        formPlatformId = a.PlatformId;
        formAccountType = a.AccountType;
        formBalance = a.Balance;
        errorMessage = null;
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingId = null;
    }

    private async Task SaveAccount()
    {
        if (string.IsNullOrWhiteSpace(formName))
        {
            errorMessage = "账户名为必填项";
            return;
        }
        if (formPlatformId == 0)
        {
            errorMessage = "请选择所属平台";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            var payload = new { Name = formName, PlatformId = formPlatformId, AccountType = formAccountType, Balance = formBalance };

            if (editingId.HasValue)
            {
                var response = await Http.PutAsJsonAsync($"api/accounts/{editingId.Value}", payload);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "保存失败";
                    return;
                }
            }
            else
            {
                var response = await Http.PostAsJsonAsync("api/accounts", payload);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "创建失败";
                    return;
                }
            }

            CloseDialog();
            await LoadData();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAccount(AccountDto a)
    {
        confirmDeleteId = a.Id;
        confirmDeleteName = a.Name;
    }

    private void CancelDelete()
    {
        confirmDeleteId = null;
        confirmDeleteName = null;
    }

    private async Task ConfirmDelete()
    {
        if (confirmDeleteId == null) return;
        var response = await Http.DeleteAsync($"api/accounts/{confirmDeleteId}");
        if (response.IsSuccessStatusCode)
        {
            await LoadData();
        }
        else
        {
            var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            errorMessage = error?.Message ?? "删除失败";
        }
        CancelDelete();
    }

    private static string GetAccountTypeName(int type) => type switch
    {
        0 => "余额",
        1 => "余额宝",
        2 => "银行卡",
        3 => "零钱",
        4 => "零钱通",
        _ => "未知"
    };

    private record AccountDto(int Id, string Name, int PlatformId, string PlatformName, int AccountType, decimal Balance, bool IsActive);
    private record PlatformDto(int Id, string Name, string Code, string? IconUrl, int AccountCount);
    private record AccountReconDto(int Id, string Name, bool IsActive, decimal? BankBalance, decimal? CalculatedBalance, decimal? Difference, DateTime? SnapshotDate);
    private record ErrorResponse(string Message);
}
