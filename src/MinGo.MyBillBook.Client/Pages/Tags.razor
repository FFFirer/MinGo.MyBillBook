@page "/tags"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>标签体系</PageTitle>
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">标签体系</h1>
            <p class="text-sm text-gray-500 mt-1">Tag 是与 Category 正交的横向维度：一笔账单可携带多个标签，规则自动打标不覆盖手工标签。</p>
        </div>
        <div class="flex gap-2">
            <button @onclick="OpenRuleDialog" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors">
                <span class="material-icons mr-2">rule</span>新增规则
            </button>
            <button @onclick="OpenTagDialog" class="inline-flex items-center px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors">
                <span class="material-icons mr-2">add</span>新增标签
            </button>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex justify-between items-center">
            <span>@errorMessage</span>
            <button @onclick="() => errorMessage = null" class="text-red-500 hover:text-red-700">
                <span class="material-icons text-lg">close</span>
            </button>
        </div>
    }

    <!-- 标签列表 -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 font-semibold text-gray-700">标签</div>
        <table class="min-w-full text-sm">
            <thead class="bg-gray-50 text-gray-500">
                <tr>
                    <th class="text-left px-6 py-3">名称</th>
                    <th class="text-left px-6 py-3">类型</th>
                    <th class="text-left px-6 py-3">作用域</th>
                    <th class="text-left px-6 py-3">已打标</th>
                    <th class="text-left px-6 py-3">排序</th>
                    <th class="text-right px-6 py-3">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (tags != null)
                {
                    @foreach (var t in tags)
                    {
                        <tr class="border-t border-gray-100">
                            <td class="px-6 py-3">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">@t.Name</span>
                            </td>
                            <td class="px-6 py-3 text-gray-500">@t.TagType</td>
                            <td class="px-6 py-3 text-gray-500">@t.Scope</td>
                            <td class="px-6 py-3 text-gray-500">@t.TaggedCount</td>
                            <td class="px-6 py-3 text-gray-500">@t.SortOrder</td>
                            <td class="px-6 py-3 text-right">
                                <button @onclick="() => OpenEditTagDialog(t)" class="p-1 text-gray-400 hover:text-purple-600" title="编辑"><span class="material-icons text-lg">edit</span></button>
                                <button @onclick="() => DeleteTag(t)" class="p-1 text-gray-400 hover:text-red-600" title="删除"><span class="material-icons text-lg">delete</span></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- 标签规则列表 -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 font-semibold text-gray-700">标签规则（按优先级降序匹配，自动打标 Source=Rule）</div>
        <table class="min-w-full text-sm">
            <thead class="bg-gray-50 text-gray-500">
                <tr>
                    <th class="text-left px-6 py-3">条件</th>
                    <th class="text-left px-6 py-3">条件值</th>
                    <th class="text-left px-6 py-3">打标</th>
                    <th class="text-left px-6 py-3">优先级</th>
                    <th class="text-left px-6 py-3">启用</th>
                    <th class="text-right px-6 py-3">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (rules != null)
                {
                    @foreach (var r in rules)
                    {
                        <tr class="border-t border-gray-100">
                            <td class="px-6 py-3 text-gray-700">@r.Condition</td>
                            <td class="px-6 py-3 font-mono text-gray-800">@r.ConditionValue</td>
                            <td class="px-6 py-3 text-gray-700">@r.TagName</td>
                            <td class="px-6 py-3 text-gray-500">@r.Priority</td>
                            <td class="px-6 py-3">
                                <span class="@(r.IsActive ? "text-green-600" : "text-gray-400")">@(r.IsActive ? "是" : "否")</span>
                            </td>
                            <td class="px-6 py-3 text-right">
                                <button @onclick="() => OpenEditRuleDialog(r)" class="p-1 text-gray-400 hover:text-indigo-600" title="编辑"><span class="material-icons text-lg">edit</span></button>
                                <button @onclick="() => DeleteRule(r)" class="p-1 text-gray-400 hover:text-red-600" title="删除"><span class="material-icons text-lg">delete</span></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 标签新增/编辑弹窗 -->
@if (showTagDialog)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="CloseTagDialog">
        <div class="bg-white rounded-xl shadow-xl p-6 max-w-md w-full mx-4" @onclick:stopPropagation>
            <h2 class="text-lg font-semibold text-gray-800 mb-4">@(editingTagId.HasValue ? "编辑标签" : "新增标签")</h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">名称</label>
                    <input @bind="tagName" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500" placeholder="如：周末" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">类型</label>
                    <select @bind="tagType" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
                        <option value="0">Scenario（场景）</option>
                        <option value="1">Purpose（用途）</option>
                        <option value="2">Nature（性质）</option>
                        <option value="3">Project（项目）</option>
                        <option value="4">Status（状态）</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">作用域</label>
                    <select @bind="tagScope" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
                        <option value="0">Global（全局）</option>
                        <option value="1">Category（限定分类）</option>
                        <option value="2">Account（限定账户）</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">排序</label>
                    <input type="number" @bind="tagSortOrder" class="w-full px-3 py-2 border border-gray-300 rounded-lg" />
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-6">
                <button @onclick="CloseTagDialog" class="px-4 py-2 text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50">取消</button>
                <button @onclick="SaveTag" disabled="@isSaving" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 disabled:opacity-50">@(isSaving ? "保存中..." : "保存")</button>
            </div>
        </div>
    </div>
}

<!-- 规则新增/编辑弹窗 -->
@if (showRuleDialog)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="CloseRuleDialog">
        <div class="bg-white rounded-xl shadow-xl p-6 max-w-md w-full mx-4" @onclick:stopPropagation>
            <h2 class="text-lg font-semibold text-gray-800 mb-4">@(editingRuleId.HasValue ? "编辑规则" : "新增规则")</h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">条件</label>
                    <select @bind="ruleCondition" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
                        <option value="0">Category（分类）</option>
                        <option value="1">Merchant（商户）</option>
                        <option value="2">DayOfWeek（星期）</option>
                        <option value="3">AmountRange（金额区间）</option>
                        <option value="4">Keyword（关键词）</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">条件值</label>
                    <input @bind="ruleConditionValue" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500" placeholder="@ConditionHint" />
                    <p class="text-xs text-gray-400 mt-1">@ConditionHint</p>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">打标到</label>
                    <select @bind="ruleTagId" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
                        <option value="0">— 请选择 —</option>
                        @if (tags != null)
                        {
                            @foreach (var t in tags)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">优先级</label>
                    <input type="number" @bind="rulePriority" class="w-full px-3 py-2 border border-gray-300 rounded-lg" />
                </div>
                <label class="flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" @bind="ruleIsActive" /> 启用
                </label>
            </div>
            <div class="flex justify-end gap-3 mt-6">
                <button @onclick="CloseRuleDialog" class="px-4 py-2 text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50">取消</button>
                <button @onclick="SaveRule" disabled="@isSaving" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 disabled:opacity-50">@(isSaving ? "保存中..." : "保存")</button>
            </div>
        </div>
    </div>
}

@code {
    private List<TagDto>? tags;
    private List<TagRuleDto>? rules;
    private bool showTagDialog, showRuleDialog, isSaving;
    private string? errorMessage;

    private int? editingTagId;
    private string tagName = string.Empty;
    private int tagType;
    private int tagScope;
    private int tagSortOrder;

    private int? editingRuleId;
    private int ruleCondition = 4;
    private string ruleConditionValue = string.Empty;
    private int ruleTagId;
    private int rulePriority;
    private bool ruleIsActive = true;

    private string ConditionHint => ruleCondition switch
    {
        0 => "分类名或 Id，如：旅行",
        1 => "商户名或 Id，如：星巴克",
        2 => "星期，逗号分隔，如：Sat,Sun",
        3 => "金额区间（元），如：100-500",
        _ => "关键词子串，如：报销",
    };

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        tags = await Http.GetFromJsonAsync<List<TagDto>>("api/tags");
        rules = await Http.GetFromJsonAsync<List<TagRuleDto>>("api/tag-rules");
    }

    // === 标签 ===
    private void OpenTagDialog()
    {
        editingTagId = null; tagName = string.Empty; tagType = 0; tagScope = 0; tagSortOrder = 0;
        errorMessage = null; showTagDialog = true;
    }
    private void OpenEditTagDialog(TagDto t)
    {
        editingTagId = t.Id; tagName = t.Name; tagType = EnumIndex(t.TagType, TagTypes); tagScope = EnumIndex(t.Scope, TagScopes);
        tagSortOrder = t.SortOrder; errorMessage = null; showTagDialog = true;
    }
    private void CloseTagDialog() { showTagDialog = false; editingTagId = null; }

    private async Task SaveTag()
    {
        if (string.IsNullOrWhiteSpace(tagName)) { errorMessage = "名称为必填项"; return; }
        isSaving = true; errorMessage = null;
        try
        {
            var payload = new { Name = tagName, TagType = tagType, Scope = tagScope, ScopeId = (int?)null, SortOrder = tagSortOrder };
            var resp = editingTagId.HasValue
                ? await Http.PutAsJsonAsync($"api/tags/{editingTagId.Value}", payload)
                : await Http.PostAsJsonAsync("api/tags", payload);
            if (!resp.IsSuccessStatusCode) { errorMessage = "保存失败"; return; }
            CloseTagDialog();
            await LoadAll();
        }
        finally { isSaving = false; }
    }

    private async Task DeleteTag(TagDto t)
    {
        var resp = await Http.DeleteAsync($"api/tags/{t.Id}");
        if (resp.IsSuccessStatusCode) await LoadAll();
        else errorMessage = $"删除「{t.Name}」失败";
    }

    // === 规则 ===
    private void OpenRuleDialog()
    {
        editingRuleId = null; ruleCondition = 4; ruleConditionValue = string.Empty; ruleTagId = 0; rulePriority = 0; ruleIsActive = true;
        errorMessage = null; showRuleDialog = true;
    }
    private void OpenEditRuleDialog(TagRuleDto r)
    {
        editingRuleId = r.Id; ruleCondition = EnumIndex(r.Condition, Conditions); ruleConditionValue = r.ConditionValue;
        ruleTagId = r.TagId; rulePriority = r.Priority; ruleIsActive = r.IsActive; errorMessage = null; showRuleDialog = true;
    }
    private void CloseRuleDialog() { showRuleDialog = false; editingRuleId = null; }

    private async Task SaveRule()
    {
        if (string.IsNullOrWhiteSpace(ruleConditionValue) || ruleTagId == 0) { errorMessage = "条件值与目标标签为必填项"; return; }
        isSaving = true; errorMessage = null;
        try
        {
            var payload = new { Condition = ruleCondition, ConditionValue = ruleConditionValue, TagId = ruleTagId, Priority = rulePriority, IsActive = ruleIsActive };
            var resp = editingRuleId.HasValue
                ? await Http.PutAsJsonAsync($"api/tag-rules/{editingRuleId.Value}", payload)
                : await Http.PostAsJsonAsync("api/tag-rules", payload);
            if (!resp.IsSuccessStatusCode) { errorMessage = "保存失败"; return; }
            CloseRuleDialog();
            await LoadAll();
        }
        finally { isSaving = false; }
    }

    private async Task DeleteRule(TagRuleDto r)
    {
        var resp = await Http.DeleteAsync($"api/tag-rules/{r.Id}");
        if (resp.IsSuccessStatusCode) await LoadAll();
        else errorMessage = "删除规则失败";
    }

    private static readonly string[] TagTypes = ["Scenario", "Purpose", "Nature", "Project", "Status"];
    private static readonly string[] TagScopes = ["Global", "Category", "Account"];
    private static readonly string[] Conditions = ["Category", "Merchant", "DayOfWeek", "AmountRange", "Keyword"];

    private static int EnumIndex(string value, string[] names)
    {
        var idx = Array.FindIndex(names, n => string.Equals(n, value, StringComparison.OrdinalIgnoreCase));
        return idx < 0 ? 0 : idx;
    }

    private record TagDto(int Id, string Name, string TagType, string Scope, int? ScopeId, int SortOrder, int TaggedCount);
    private record TagRuleDto(int Id, string Condition, string ConditionValue, int TagId, string TagName, int Priority, bool IsActive);
}
