@page "/tags"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>标签体系</PageTitle>
<div class="space-y-4 sm:space-y-6">
    <div class="page-header">
        <div class="min-w-0">
            <h1>标签体系</h1>
            <p class="text-body-small text-on-surface-variant mt-1">Tag 是与 Category 正交的横向维度：一笔账单可携带多个标签，规则自动打标不覆盖手工标签。</p>
        </div>
        <div class="actions w-full sm:w-auto">
            <button @onclick="OpenRuleDialog" class="flex-none md-btn-tonal state-layer">
                <span class="material-symbols-outlined mr-1 sm:mr-2">rule</span><span class="hidden xs:inline">新增规则</span><span class="xs:hidden">规则</span>
            </button>
            <button @onclick="OpenTagDialog" class="flex-none md-btn-filled state-layer">
                <span class="material-symbols-outlined mr-1 sm:mr-2">add</span><span class="hidden xs:inline">新增标签</span><span class="xs:hidden">标签</span>
            </button>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="bg-error-container text-on-error-container px-4 py-3 rounded-md flex justify-between items-start gap-3" role="alert">
            <span class="flex-1 text-body-medium break-words">@errorMessage</span>
            <button @onclick="() => errorMessage = null" class="md-icon-btn shrink-0" aria-label="关闭">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }

    <!-- 标签列表 -->
    <div class="md-card-elevated overflow-hidden">
        <div class="card-header">
            <span class="material-symbols-outlined card-header-icon">sell</span>
            <h2 class="card-header-title">标签</h2>
            <span class="md-chip md-chip-assist-primary text-body-small">@(tags?.Count ?? 0)</span>
        </div>

        @if (tags == null)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">loading_spinner</span>
                <p>加载中...</p>
            </div>
        }
        else if (tags.Count == 0)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">sell</span>
                <p class="text-body-medium">暂无标签</p>
                <p class="text-body-small mt-1">点击上方「新增标签」创建第一个标签</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="md-table responsive-cards">
                    <thead>
                        <tr>
                            <th class="text-left">名称</th>
                            <th class="text-left">类型</th>
                            <th class="text-left hide-mobile">作用域</th>
                            <th class="text-left">已打标</th>
                            <th class="text-left hide-mobile">排序</th>
                            <th class="text-right">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in PagedTags)
                        {
                            <tr>
                                <td data-label="名称">
                                    <span class="md-chip md-chip-assist-primary">@t.Name</span>
                                </td>
                                <td data-label="类型">
                                    <span class="@GetTagTypeChipClass(t.TagType)">@GetTagTypeDisplayName(t.TagType)</span>
                                </td>
                                <td data-label="作用域" class="text-on-surface-variant hide-mobile">@GetScopeDisplayName(t.Scope)</td>
                                <td data-label="已打标" class="tabular-nums">
                                    @if (t.TaggedCount > 0)
                                    {
                                        <span class="md-chip md-chip-assist-info">@t.TaggedCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-on-surface-variant">0</span>
                                    }
                                </td>
                                <td data-label="排序" class="text-on-surface-variant tabular-nums hide-mobile">@t.SortOrder</td>
                                <td data-label="操作" class="text-right">
                                    <div class="inline-flex items-center justify-end gap-1">
                                        <button @onclick="() => OpenEditTagDialog(t)" class="md-icon-btn" title="编辑" aria-label="编辑标签 @t.Name"><span class="material-symbols-outlined">edit</span></button>
                                        <button @onclick="() => ConfirmDeleteTag(t)" class="md-icon-btn" title="删除" aria-label="删除标签 @t.Name"><span class="material-symbols-outlined text-error">delete</span></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Paginator TotalCount="@(tags?.Count ?? 0)" PageSize="PageSize" @bind-Page="tagsPage" />
        }
    </div>

    <!-- 标签规则列表 -->
    <div class="md-card-elevated overflow-hidden">
        <div class="card-header">
            <span class="material-symbols-outlined card-header-icon">rule</span>
            <h2 class="card-header-title">标签规则</h2>
            <span class="card-header-subtitle hidden sm:inline">（按优先级降序匹配，自动打标 Source=Rule）</span>
            <span class="md-chip md-chip-assist-primary text-body-small">@(rules?.Count ?? 0)</span>
        </div>

        @if (rules == null)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">loading_spinner</span>
                <p>加载中...</p>
            </div>
        }
        else if (rules.Count == 0)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">rule</span>
                <p class="text-body-medium">暂无规则</p>
                <p class="text-body-small mt-1">点击上方「新增规则」创建自动打标规则</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="md-table responsive-cards">
                    <thead>
                        <tr>
                            <th class="text-left">条件</th>
                            <th class="text-left">条件值</th>
                            <th class="text-left">打标</th>
                            <th class="text-left hide-mobile">优先级</th>
                            <th class="text-left hide-mobile">启用</th>
                            <th class="text-right">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in PagedRules)
                        {
                            <tr>
                                <td data-label="条件">
                                    <span class="@GetConditionChipClass(r.Condition)">@GetConditionDisplayName(r.Condition)</span>
                                </td>
                                <td data-label="条件值" class="font-mono wrap-cell"><span class="break-all text-body-small text-on-surface">@r.ConditionValue</span></td>
                                <td data-label="打标">
                                    <span class="md-chip md-chip-assist-primary">@r.TagName</span>
                                </td>
                                <td data-label="优先级" class="tabular-nums text-on-surface-variant hide-mobile">@r.Priority</td>
                                <td data-label="启用" class="hide-mobile">
                                    @if (r.IsActive)
                                    {
                                        <span class="md-chip md-chip-assist-success">启用</span>
                                    }
                                    else
                                    {
                                        <span class="md-chip md-chip-assist-error">停用</span>
                                    }
                                </td>
                                <td data-label="操作" class="text-right">
                                    <div class="inline-flex items-center justify-end gap-1">
                                        <button @onclick="() => OpenEditRuleDialog(r)" class="md-icon-btn" title="编辑" aria-label="编辑规则"><span class="material-symbols-outlined">edit</span></button>
                                        <button @onclick="() => ConfirmDeleteRule(r)" class="md-icon-btn" title="删除" aria-label="删除规则"><span class="material-symbols-outlined text-error">delete</span></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Paginator TotalCount="@(rules?.Count ?? 0)" PageSize="PageSize" @bind-Page="rulesPage" />
        }
    </div>
</div>

<!-- 删除确认弹窗 -->
@if (confirmDeleteItem != null)
{
    <div class="modal-root" @onclick="CancelDelete" role="alertdialog" aria-modal="true" aria-label="确认删除">
        <div class="modal-panel modal-sm" @onclick:stopPropagation>
            <div class="flex items-center mb-4">
                <div class="p-2 rounded-full bg-error-container mr-3 shrink-0">
                    <span class="material-symbols-outlined text-error">warning</span>
                </div>
                <h2 class="text-title-large text-on-surface">确认删除</h2>
            </div>
            <p class="text-body-medium text-on-surface-variant mb-6">
                确定要删除@(confirmDeleteItem.IsRule ? "规则" : "标签")「<strong class="text-on-surface">@confirmDeleteItem.Name</strong>」吗？此操作不可撤销。
            </p>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3">
                <button @onclick="CancelDelete" class="md-btn-outlined state-layer w-full sm:w-auto">取消</button>
                <button @onclick="ExecuteDelete" class="md-btn-danger state-layer w-full sm:w-auto">确认删除</button>
            </div>
        </div>
    </div>
}

<!-- 标签新增/编辑弹窗 -->
@if (showTagDialog)
{
    <div class="modal-root" @onclick="CloseTagDialog" role="dialog" aria-modal="true" aria-label="@(editingTagId.HasValue ? "编辑标签" : "新增标签")">
        <div class="modal-panel modal-sm" @onclick:stopPropagation>
            <div class="flex items-center mb-4">
                <div class="p-2 rounded-full bg-primary-container mr-3 shrink-0">
                    <span class="material-symbols-outlined text-on-primary-container">sell</span>
                </div>
                <h2 class="text-title-large text-on-surface">@(editingTagId.HasValue ? "编辑标签" : "新增标签")</h2>
            </div>
            <div class="space-y-4">
                <div>
                    <label for="tagNameInput" class="block text-body-small text-on-surface-variant mb-1">名称</label>
                    <input id="tagNameInput" @bind="tagName" class="md-text-field-outlined w-full" placeholder="如：周末" />
                </div>
                <div>
                    <label for="tagTypeSelect" class="block text-body-small text-on-surface-variant mb-1">类型</label>
                    <select id="tagTypeSelect" @bind="tagType" class="md-text-field-outlined w-full">
                        <option value="0">Scenario（场景）</option>
                        <option value="1">Purpose（用途）</option>
                        <option value="2">Nature（性质）</option>
                        <option value="3">Project（项目）</option>
                        <option value="4">Status（状态）</option>
                    </select>
                </div>
                <div>
                    <label for="tagScopeSelect" class="block text-body-small text-on-surface-variant mb-1">作用域</label>
                    <select id="tagScopeSelect" @bind="tagScope" class="md-text-field-outlined w-full">
                        <option value="0">Global（全局）</option>
                        <option value="1">Category（限定分类）</option>
                        <option value="2">Account（限定账户）</option>
                    </select>
                </div>
                <div>
                    <label for="tagSortInput" class="block text-body-small text-on-surface-variant mb-1">排序</label>
                    <input id="tagSortInput" type="number" @bind="tagSortOrder" class="md-text-field-outlined w-full" />
                </div>
            </div>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3 mt-6">
                <button @onclick="CloseTagDialog" class="md-btn-outlined state-layer w-full sm:w-auto">取消</button>
                <button @onclick="SaveTag" disabled="@isSaving" class="md-btn-filled state-layer w-full sm:w-auto">@(isSaving ? "保存中…" : "保存")</button>
            </div>
        </div>
    </div>
}

<!-- 规则新增/编辑弹窗 -->
@if (showRuleDialog)
{
    <div class="modal-root" @onclick="CloseRuleDialog" role="dialog" aria-modal="true" aria-label="@(editingRuleId.HasValue ? "编辑规则" : "新增规则")">
        <div class="modal-panel modal-sm" @onclick:stopPropagation>
            <div class="flex items-center mb-4">
                <div class="p-2 rounded-full bg-secondary-container mr-3 shrink-0">
                    <span class="material-symbols-outlined text-on-secondary-container">rule</span>
                </div>
                <h2 class="text-title-large text-on-surface">@(editingRuleId.HasValue ? "编辑规则" : "新增规则")</h2>
            </div>
            <div class="space-y-4">
                <div>
                    <label for="ruleCondSelect" class="block text-body-small text-on-surface-variant mb-1">条件</label>
                    <select id="ruleCondSelect" @bind="ruleCondition" class="md-text-field-outlined w-full">
                        <option value="0">Category（分类）</option>
                        <option value="1">Merchant（商户）</option>
                        <option value="2">DayOfWeek（星期）</option>
                        <option value="3">AmountRange（金额区间）</option>
                        <option value="4">Keyword（关键词）</option>
                    </select>
                </div>
                <div>
                    <label for="ruleCondValueInput" class="block text-body-small text-on-surface-variant mb-1">条件值</label>
                    <input id="ruleCondValueInput" @bind="ruleConditionValue" class="md-text-field-outlined w-full" placeholder="@ConditionHint" />
                    <p class="text-body-small text-on-surface-variant mt-1">@ConditionHint</p>
                </div>
                <div>
                    <label for="ruleTagSelect" class="block text-body-small text-on-surface-variant mb-1">打标到</label>
                    <select id="ruleTagSelect" @bind="ruleTagId" class="md-text-field-outlined w-full">
                        <option value="0">— 请选择 —</option>
                        @if (tags != null)
                        {
                            @foreach (var t in tags)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label for="rulePriorityInput" class="block text-body-small text-on-surface-variant mb-1">优先级</label>
                    <input id="rulePriorityInput" type="number" @bind="rulePriority" class="md-text-field-outlined w-full" />
                    <p class="text-body-small text-on-surface-variant mt-1">数值越大优先级越高</p>
                </div>
                <label class="flex items-center gap-2 text-body-medium text-on-surface min-h-[44px] cursor-pointer">
                    <input type="checkbox" @bind="ruleIsActive" class="w-5 h-5 rounded border-outline text-primary focus:ring-primary/40" /> 启用
                </label>
            </div>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3 mt-6">
                <button @onclick="CloseRuleDialog" class="md-btn-outlined state-layer w-full sm:w-auto">取消</button>
                <button @onclick="SaveRule" disabled="@isSaving" class="md-btn-filled state-layer w-full sm:w-auto">@(isSaving ? "保存中…" : "保存")</button>
            </div>
        </div>
    </div>
}

@code {
    private List<TagDto>? tags;
    private List<TagRuleDto>? rules;
    private int tagsPage = 1;
    private int rulesPage = 1;
    private const int PageSize = 20;
    private IEnumerable<TagDto> PagedTags => tags?.Skip((tagsPage - 1) * PageSize).Take(PageSize) ?? [];
    private IEnumerable<TagRuleDto> PagedRules => rules?.Skip((rulesPage - 1) * PageSize).Take(PageSize) ?? [];
    private bool showTagDialog, showRuleDialog, isSaving;
    private string? errorMessage;

    private int? editingTagId;
    private string tagName = string.Empty;
    private int tagType;
    private int tagScope;
    private int tagSortOrder;

    private int? editingRuleId;
    private int ruleCondition = 4;
    private string ruleConditionValue = string.Empty;
    private int ruleTagId;
    private int rulePriority;
    private bool ruleIsActive = true;

    private ConfirmDeleteItem? confirmDeleteItem;

    private string ConditionHint => ruleCondition switch
    {
        0 => "分类名或 Id，如：旅行",
        1 => "商户名或 Id，如：星巴克",
        2 => "星期，逗号分隔，如：Sat,Sun",
        3 => "金额区间（元），如：100-500",
        _ => "关键词子串，如：报销",
    };

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        tags = await Http.GetFromJsonAsync<List<TagDto>>("api/tags");
        rules = await Http.GetFromJsonAsync<List<TagRuleDto>>("api/tag-rules");
    }

    // === 标签 ===
    private void OpenTagDialog()
    {
        editingTagId = null; tagName = string.Empty; tagType = 0; tagScope = 0; tagSortOrder = 0;
        errorMessage = null; showTagDialog = true;
    }
    private void OpenEditTagDialog(TagDto t)
    {
        editingTagId = t.Id; tagName = t.Name; tagType = EnumIndex(t.TagType, TagTypes); tagScope = EnumIndex(t.Scope, TagScopes);
        tagSortOrder = t.SortOrder; errorMessage = null; showTagDialog = true;
    }
    private void CloseTagDialog() { showTagDialog = false; editingTagId = null; }

    private async Task SaveTag()
    {
        if (string.IsNullOrWhiteSpace(tagName)) { errorMessage = "名称为必填项"; return; }
        isSaving = true; errorMessage = null;
        try
        {
            var payload = new { Name = tagName, TagType = tagType, Scope = tagScope, ScopeId = (int?)null, SortOrder = tagSortOrder };
            var resp = editingTagId.HasValue
                ? await Http.PutAsJsonAsync($"api/tags/{editingTagId.Value}", payload)
                : await Http.PostAsJsonAsync("api/tags", payload);
            if (!resp.IsSuccessStatusCode) { errorMessage = "保存失败"; return; }
            CloseTagDialog();
            await LoadAll();
        }
        finally { isSaving = false; }
    }

    private void ConfirmDeleteTag(TagDto t)
    {
        confirmDeleteItem = new ConfirmDeleteItem(t.Id, t.Name, false);
    }

    // === 规则 ===
    private void OpenRuleDialog()
    {
        editingRuleId = null; ruleCondition = 4; ruleConditionValue = string.Empty; ruleTagId = 0; rulePriority = 0; ruleIsActive = true;
        errorMessage = null; showRuleDialog = true;
    }
    private void OpenEditRuleDialog(TagRuleDto r)
    {
        editingRuleId = r.Id; ruleCondition = EnumIndex(r.Condition, Conditions); ruleConditionValue = r.ConditionValue;
        ruleTagId = r.TagId; rulePriority = r.Priority; ruleIsActive = r.IsActive; errorMessage = null; showRuleDialog = true;
    }
    private void CloseRuleDialog() { showRuleDialog = false; editingRuleId = null; }

    private async Task SaveRule()
    {
        if (string.IsNullOrWhiteSpace(ruleConditionValue) || ruleTagId == 0) { errorMessage = "条件值与目标标签为必填项"; return; }
        isSaving = true; errorMessage = null;
        try
        {
            var payload = new { Condition = ruleCondition, ConditionValue = ruleConditionValue, TagId = ruleTagId, Priority = rulePriority, IsActive = ruleIsActive };
            var resp = editingRuleId.HasValue
                ? await Http.PutAsJsonAsync($"api/tag-rules/{editingRuleId.Value}", payload)
                : await Http.PostAsJsonAsync("api/tag-rules", payload);
            if (!resp.IsSuccessStatusCode) { errorMessage = "保存失败"; return; }
            CloseRuleDialog();
            await LoadAll();
        }
        finally { isSaving = false; }
    }

    private void ConfirmDeleteRule(TagRuleDto r)
    {
        confirmDeleteItem = new ConfirmDeleteItem(r.Id, $"{r.Condition}={r.ConditionValue} → {r.TagName}", true);
    }

    // === 删除确认 ===
    private void CancelDelete() { confirmDeleteItem = null; }

    private async Task ExecuteDelete()
    {
        if (confirmDeleteItem == null) return;
        var url = confirmDeleteItem.IsRule ? $"api/tag-rules/{confirmDeleteItem.Id}" : $"api/tags/{confirmDeleteItem.Id}";
        var resp = await Http.DeleteAsync(url);
        if (resp.IsSuccessStatusCode)
        {
            await LoadAll();
        }
        else
        {
            errorMessage = confirmDeleteItem.IsRule ? "删除规则失败" : $"删除「{confirmDeleteItem.Name}」失败";
        }
        CancelDelete();
    }

    // === 显示辅助 ===
    private static string GetTagTypeChipClass(string tagType) => tagType switch
    {
        "Scenario" => "md-chip md-chip-assist-primary",
        "Purpose" => "md-chip md-chip-assist-info",
        "Nature" => "md-chip md-chip-assist-warning",
        "Project" => "md-chip md-chip-assist-success",
        "Status" => "md-chip md-chip-assist-error",
        _ => "md-chip md-chip-assist-primary",
    };

    private static string GetTagTypeDisplayName(string tagType) => tagType switch
    {
        "Scenario" => "场景",
        "Purpose" => "用途",
        "Nature" => "性质",
        "Project" => "项目",
        "Status" => "状态",
        _ => tagType,
    };

    private static string GetScopeDisplayName(string scope) => scope switch
    {
        "Global" => "全局",
        "Category" => "限定分类",
        "Account" => "限定账户",
        _ => scope,
    };

    private static string GetConditionChipClass(string condition) => condition switch
    {
        "Category" => "md-chip md-chip-assist-primary",
        "Merchant" => "md-chip md-chip-assist-info",
        "DayOfWeek" => "md-chip md-chip-assist-warning",
        "AmountRange" => "md-chip md-chip-assist-success",
        "Keyword" => "md-chip md-chip-assist-error",
        _ => "md-chip md-chip-assist-primary",
    };

    private static string GetConditionDisplayName(string condition) => condition switch
    {
        "Category" => "分类",
        "Merchant" => "商户",
        "DayOfWeek" => "星期",
        "AmountRange" => "金额区间",
        "Keyword" => "关键词",
        _ => condition,
    };

    private static readonly string[] TagTypes = ["Scenario", "Purpose", "Nature", "Project", "Status"];
    private static readonly string[] TagScopes = ["Global", "Category", "Account"];
    private static readonly string[] Conditions = ["Category", "Merchant", "DayOfWeek", "AmountRange", "Keyword"];

    private static int EnumIndex(string value, string[] names)
    {
        var idx = Array.FindIndex(names, n => string.Equals(n, value, StringComparison.OrdinalIgnoreCase));
        return idx < 0 ? 0 : idx;
    }

    private record TagDto(int Id, string Name, string TagType, string Scope, int? ScopeId, int SortOrder, int TaggedCount);
    private record TagRuleDto(int Id, string Condition, string ConditionValue, int TagId, string TagName, int Priority, bool IsActive);
    private record ConfirmDeleteItem(int Id, string Name, bool IsRule);
}
