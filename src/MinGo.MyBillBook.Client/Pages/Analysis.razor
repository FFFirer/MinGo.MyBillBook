@page "/analysis"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

<PageTitle>消费分析</PageTitle>
<div class="space-y-4 sm:space-y-6">
    <div class="page-header">
        <h1>消费分析</h1>
        <div class="actions w-full sm:w-auto">
            <select @bind="selectedYear" @bind:after="LoadData" class="md-text-field-outlined flex-none" aria-label="选择年份">
                @foreach (var y in years)
                {
                    <option value="@y">@y 年</option>
                }
            </select>
            <button @onclick="SyncData" disabled="@isSyncing"
                    class="md-btn-filled state-layer flex-none">
                <span class="material-symbols-outlined mr-1">sync</span>
                @(isSyncing ? "同步中…" : "同步数据")
            </button>
            <a href="/api/export/analysis?start=@startDate.ToString("yyyy-MM-dd")&end=@endDate.ToString("yyyy-MM-dd")"
               download class="md-btn-filled state-layer !bg-success !text-on-success flex-none">
                <span class="material-symbols-outlined mr-1">download</span>导出
            </a>
        </div>
    </div>

    @if (toastMessage != null)
    {
        <div class="md-snackbar @(toastIsError ? "md-snackbar-error" : "md-snackbar-success")" role="status" aria-live="polite">
            @toastMessage
        </div>
    }

    @if (summary != null)
    {
        <!-- Summary Cards -->
        <div class="grid metric-grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
            <div class="md-card-elevated">
                <p class="text-body-small text-on-surface-variant mb-1">总收入</p>
                <p class="text-headline-small font-medium text-success tabular-nums">@summary.TotalIncome.ToString("F2")</p>
            </div>
            <div class="md-card-elevated">
                <p class="text-body-small text-on-surface-variant mb-1">总支出</p>
                <p class="text-headline-small font-medium text-error tabular-nums">@summary.TotalExpense.ToString("F2")</p>
            </div>
            <div class="md-card-elevated">
                <p class="text-body-small text-on-surface-variant mb-1">结余</p>
                <p class="text-headline-small font-medium tabular-nums @(summary.Balance >= 0 ? "text-info" : "text-error")">@summary.Balance.ToString("F2")</p>
            </div>
            <div class="md-card-elevated">
                <p class="text-body-small text-on-surface-variant mb-1">交易笔数</p>
                <p class="text-headline-small font-medium text-primary tabular-nums">@summary.TransactionCount</p>
            </div>
        </div>

        <!-- Monthly Trend (bar chart using CSS) -->
        @if (monthlyTrends != null && monthlyTrends.Any())
        {
            <div class="md-card-elevated">
                <h2 class="text-title-medium md:text-title-large mb-4">月度趋势 (@selectedYear 年)</h2>
                @{
                    var maxVal = monthlyTrends.Max(m => Math.Max(m.Income, m.Expense));
                }
                <div class="trend-chart flex items-end gap-1 sm:gap-2 h-40 sm:h-48">
                    @foreach (var m in monthlyTrends)
                    {
                        var incomeH = maxVal > 0 ? (int)(m.Income / maxVal * 100) : 0;
                        var expenseH = maxVal > 0 ? (int)(m.Expense / maxVal * 100) : 0;
                        <div class="bar-group flex-1 flex flex-col items-center min-w-0">
                            <div class="flex items-end gap-px sm:gap-0.5 w-full h-32 sm:h-40">
                                <div class="flex-1 bg-primary-container rounded-t transition-all" style="height:@(incomeH)%" title="收入: @m.Income.ToString("F2")" aria-label="@m.Month 收入 @m.Income.ToString("F2")"></div>
                                <div class="flex-1 bg-error-container rounded-t transition-all" style="height:@(expenseH)%" title="支出: @m.Expense.ToString("F2")" aria-label="@m.Month 支出 @m.Expense.ToString("F2")"></div>
                            </div>
                            <span class="bar-label text-[10px] sm:text-xs text-on-surface-variant mt-1 truncate w-full text-center">@m.Month.Substring(5)</span>
                        </div>
                    }
                </div>
                <div class="flex gap-4 mt-3 justify-center">
                    <span class="text-body-small text-on-surface-variant inline-flex items-center"><span class="inline-block w-3 h-3 bg-primary-container rounded mr-1"></span>收入</span>
                    <span class="text-body-small text-on-surface-variant inline-flex items-center"><span class="inline-block w-3 h-3 bg-error-container rounded mr-1"></span>支出</span>
                </div>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Category Breakdown -->
            @if (categoryStats != null && categoryStats.Any())
            {
                <div class="md-card-elevated">
                    <h2 class="text-title-large mb-4">分类占比</h2>
                    <div class="space-y-3">
                        @foreach (var c in categoryStats)
                        {
                            <div>
                                <div class="flex justify-between text-body-medium mb-1">
                                    <span class="flex items-center text-on-surface">
                                        <span class="material-symbols-outlined text-base text-primary mr-1">@c.Icon</span>
                                        @c.CategoryName
                                    </span>
                                    <span class="text-on-surface-variant">@c.Amount.ToString("F2") (@c.Percentage.ToString("F1")%)</span>
                                </div>
                                <div class="md-progress-bar">
                                    <div class="md-progress-bar-fill" style="width:@(c.Percentage)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Top Merchants -->
            @if (topMerchants != null && topMerchants.Any())
            {
                <div class="md-card-elevated">
                    <h2 class="text-title-large mb-4">商户排行 TOP 10</h2>
                    <div class="overflow-x-auto -mx-4 sm:-mx-6">
                        <table class="md-table">
                            <thead>
                                <tr>
                                    <th class="w-10">#</th>
                                    <th>商户</th>
                                    <th class="text-right">金额</th>
                                    <th class="text-right">笔数</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < topMerchants.Count; i++)
                                {
                                    var m = topMerchants[i];
                                    <tr>
                                        <td>
                                            <span class="w-6 h-6 rounded-full bg-primary-container text-on-primary-container text-xs inline-flex items-center justify-center font-bold">@(i + 1)</span>
                                        </td>
                                        <td class="font-medium text-on-surface">@m.Merchant</td>
                                        <td class="text-right text-error font-medium">@m.Amount.ToString("F2")</td>
                                        <td class="text-right text-on-surface-variant">@m.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- 现金流 + 净资产 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md-card-elevated">
                <h2 class="text-title-large mb-4">净资产</h2>
                @if (netWorth != null)
                {
                    <p class="text-headline-small font-medium text-info mb-4">@netWorth.Total.ToString("F2")</p>
                    <div class="space-y-2">
                        @foreach (var a in netWorth.Accounts)
                        {
                            <div class="flex justify-between text-body-medium">
                                <span class="text-on-surface-variant">@a.AccountName</span>
                                <span class="font-medium text-on-surface">@a.Balance.ToString("F2")</span>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="md-card-elevated">
                <h2 class="text-title-large mb-4">现金流 (@selectedYear 年、Transfer 不计)</h2>
                @if (cashFlow != null)
                {
                    <div class="overflow-x-auto -mx-4 sm:-mx-6">
                        <table class="md-table">
                            <thead>
                                <tr>
                                    <th>月份</th>
                                    <th class="text-right">流入</th>
                                    <th class="text-right">流出</th>
                                    <th class="text-right">净额</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cf in cashFlow.Where(c => c.Inflow != 0 || c.Outflow != 0))
                                {
                                    <tr>
                                        <td class="text-on-surface">@cf.Month</td>
                                        <td class="text-right text-success">@cf.Inflow.ToString("F2")</td>
                                        <td class="text-right text-error">@cf.Outflow.ToString("F2")</td>
                                        <td class="text-right font-medium @(cf.Net >= 0 ? "text-info" : "text-error")">@cf.Net.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- 多维月度交叉分析 -->
        <div class="md-card-elevated">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                <h2 class="text-title-medium md:text-title-large">多维月度分析 (@selectedYear 年)</h2>
                <div class="flex gap-2 overflow-x-auto pb-1 -mx-1 px-1 sm:mx-0 sm:px-0 sm:pb-0" role="tablist" aria-label="分析维度">
                    @foreach (var d in dimensions)
                    {
                        <button @onclick="() => SwitchDimension(d)" role="tab" aria-selected="@(selectedDimension == d)"
                                class="md-chip @(selectedDimension == d ? "md-chip-assist-primary" : "md-chip-assist-info") whitespace-nowrap">@d</button>
                    }
                </div>
            </div>
            @if (dimensionStats != null && dimensionStats.Any())
            {
                var names = PagedDimensionNames;
                var allNames = dimensionStats.Select(s => s.Name).Distinct().ToList();
                var months = Enumerable.Range(1, 12).Select(m => $"{selectedYear}-{m:D2}").ToList();
                var lookup = dimensionStats.GroupBy(s => (s.Name, s.Month)).ToDictionary(g => g.Key, g => g.Sum(x => x.Amount));
                var maxAmt = dimensionStats.Max(s => Math.Abs(s.Amount));
                <p class="text-body-small text-on-surface-variant mb-2 sm:hidden">← 左右滑动查看完整表格，首列已固定</p>
                <div class="overflow-x-auto matrix-scroll scroll-hint" @onscroll="OnMatrixScroll" @ref="matrixScrollRef">
                    <table class="text-body-medium border-collapse min-w-max">
                        <thead>
                            <tr>
                                <th class="text-left py-2 px-2 sticky left-0 z-10 text-on-surface">@DimensionLabel()</th>
                                @foreach (var mo in months)
                                {
                                    <th class="py-2 px-2 text-right text-on-surface-variant font-normal whitespace-nowrap">@mo.Substring(5)</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var n in names)
                            {
                                <tr class="border-t border-outline-variant">
                                    <td class="py-1.5 px-2 font-medium text-on-surface sticky left-0 z-10 whitespace-nowrap max-w-[8rem] truncate" title="@n">@n</td>
                                    @foreach (var mo in months)
                                    {
                                        var amt = lookup.GetValueOrDefault((n, mo), 0m);
                                        var intensity = maxAmt > 0 ? Math.Abs(amt) / maxAmt * 0.5m : 0m;
                                        <td class="py-1.5 px-2 text-right tabular-nums whitespace-nowrap text-on-surface" style="background-color:color-mix(in srgb, var(--color-primary) @(intensity.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%, transparent)" title="@n @mo: @amt.ToString("F2")">@((amt != 0) ? amt.ToString("F0") : "")</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Paginator TotalCount="@allNames.Count" PageSize="PageSize" @bind-Page="dimensionPage" />
            }
            else
            {
                <p class="text-on-surface-variant text-body-medium">该维度暂无数据</p>
            }
        </div>

        <!-- Category × Tag 矩阵 -->
        <div class="md-card-elevated">
            <h2 class="text-title-medium md:text-title-large mb-4">Category × Tag 交叉矩阵</h2>
            @if (categoryTagMatrix != null && categoryTagMatrix.Any())
            {
                var allCats = categoryTagMatrix.Select(c => c.CategoryName).Distinct().ToList();
                var cats = PagedCategoryNames;
                var tags = categoryTagMatrix.Select(c => c.TagName).Distinct().ToList();
                var lookup = categoryTagMatrix.GroupBy(c => (c.CategoryName, c.TagName)).ToDictionary(g => g.Key, g => g.Sum(x => x.Amount));
                var maxAmt = categoryTagMatrix.Max(c => c.Amount);
                <p class="text-body-small text-on-surface-variant mb-2 sm:hidden">← 左右滑动查看完整矩阵，首列已固定</p>
                <div class="overflow-x-auto matrix-scroll scroll-hint">
                    <table class="text-body-medium border-collapse min-w-max">
                        <thead>
                            <tr>
                                <th class="text-left py-2 px-2 sticky left-0 z-10 text-on-surface">分类＼标签</th>
                                @foreach (var t in tags)
                                {
                                    <th class="py-2 px-2 text-right text-on-surface-variant font-normal whitespace-nowrap">@t</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in cats)
                            {
                                <tr class="border-t border-outline-variant">
                                    <td class="py-1.5 px-2 font-medium text-on-surface sticky left-0 z-10 whitespace-nowrap max-w-[8rem] truncate" title="@cat">@cat</td>
                                    @foreach (var t in tags)
                                    {
                                        var amt = lookup.GetValueOrDefault((cat, t), 0m);
                                        var intensity = maxAmt > 0 ? amt / maxAmt * 0.5m : 0m;
                                        <td class="py-1.5 px-2 text-right tabular-nums whitespace-nowrap text-on-surface" style="background-color:color-mix(in srgb, var(--color-primary) @(intensity.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%, transparent)" title="@cat × @t: @amt.ToString("F2")">@((amt != 0) ? amt.ToString("F0") : "")</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Paginator TotalCount="@allCats.Count" PageSize="PageSize" @bind-Page="catTagPage" />
            }
            else
            {
                <p class="text-on-surface-variant text-body-medium">暂无标签交叉数据（请先给账单打标签并同步）</p>
            }
        </div>
    }
    else
    {
        <div class="md-card-elevated p-8 sm:p-12 text-center empty-state">
            <span class="material-symbols-outlined">analytics</span>
            <p class="text-on-surface-variant">暂无分析数据</p>
            <p class="text-body-small text-on-surface-variant mt-1">请先导入并处理对账单数据，然后点击"同步数据"</p>
        </div>
    }
</div>

@code {
    private AnalysisSummary? summary;
    private List<CategoryStatDto>? categoryStats;
    private List<MonthlyTrendDto>? monthlyTrends;
    private List<MerchantRankDto>? topMerchants;
    private NetWorthDto? netWorth;
    private List<CashFlowDto>? cashFlow;
    private List<DimensionMonthStatDto>? dimensionStats;
    private List<CategoryTagCellDto>? categoryTagMatrix;
    private string[] dimensions = ["账户", "商户", "标签"];
    private string selectedDimension = "商户";
    private int selectedYear = DateTime.Today.Year;
    private int[] years = Enumerable.Range(DateTime.Today.Year - 3, 4).Reverse().ToArray();
    private bool isSyncing;
    private string? toastMessage;
    private bool toastIsError;
    private int dimensionPage = 1;
    private int catTagPage = 1;
    private const int PageSize = 20;
    private DateTime startDate => new(selectedYear, 1, 1);
    private DateTime endDate => new(selectedYear, 12, 31);

    private List<string> PagedDimensionNames =>
        dimensionStats?.Select(s => s.Name).Distinct().ToList() is { } all
            ? all.Skip((dimensionPage - 1) * PageSize).Take(PageSize).ToList()
            : [];

    private List<string> PagedCategoryNames =>
        categoryTagMatrix?.Select(c => c.CategoryName).Distinct().ToList() is { } all
            ? all.Skip((catTagPage - 1) * PageSize).Take(PageSize).ToList()
            : [];

    private HubConnection? hubConnection;
    private ElementReference matrixScrollRef;

    private void OnMatrixScroll(EventArgs e)
    {
        // 预留：可用于滚动到底部时移除 scroll-hint 阴影
    }

    protected override async Task OnInitializedAsync()
    {
        // Setup SignalR
        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/notifications"))
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On("DataSynced", async () =>
        {
            ShowToast("数据已同步");
            await LoadData();
        });

        hubConnection.On<int, int>("BatchProcessed", async (batchId, count) =>
        {
            ShowToast($"已处理 {count} 条记录");
        });

        try { await hubConnection.StartAsync(); } catch { /* SignalR not critical */ }

        await LoadData();
        if (summary is { TransactionCount: 0 })
        {
            await SyncData();
        }
    }

    private async Task LoadData()
    {
        var startStr = startDate.ToString("yyyy-MM-dd");
        var endStr = endDate.ToString("yyyy-MM-dd");
        dimensionPage = 1;
        catTagPage = 1;
        summary = await Http.GetFromJsonAsync<AnalysisSummary>($"api/analysis/summary?start={startStr}&end={endStr}");
        categoryStats = await Http.GetFromJsonAsync<List<CategoryStatDto>>($"api/analysis/category?start={startStr}&end={endStr}");
        monthlyTrends = await Http.GetFromJsonAsync<List<MonthlyTrendDto>>($"api/analysis/trend?year={selectedYear}");
        topMerchants = await Http.GetFromJsonAsync<List<MerchantRankDto>>($"api/analysis/merchants?start={startStr}&end={endStr}&limit=10");
        netWorth = await Http.GetFromJsonAsync<NetWorthDto>("api/analysis/net-worth");
        cashFlow = await Http.GetFromJsonAsync<List<CashFlowDto>>($"api/analysis/cash-flow?year={selectedYear}");
        categoryTagMatrix = await Http.GetFromJsonAsync<List<CategoryTagCellDto>>($"api/analysis/category-tag-matrix?start={startStr}&end={endStr}");
        await LoadDimensionAsync();
    }

    private async Task LoadDimensionAsync()
    {
        var endpoint = selectedDimension switch
        {
            "账户" => "account-monthly",
            "标签" => "tag-monthly",
            _ => "merchant-monthly"
        };
        dimensionStats = await Http.GetFromJsonAsync<List<DimensionMonthStatDto>>($"api/analysis/{endpoint}?year={selectedYear}");
    }

    private async Task SwitchDimension(string d)
    {
        selectedDimension = d;
        dimensionPage = 1;
        await LoadDimensionAsync();
    }

    private string DimensionLabel() => selectedDimension switch
    {
        "账户" => "账户＼月",
        "标签" => "标签＼月",
        _ => "商户＼月"
    };

    private async Task SyncData()
    {
        isSyncing = true;
        StateHasChanged();
        try
        {
            await Http.PostAsync("api/analysis/sync", null);
            ShowToast("数据同步完成");
            await LoadData();
        }
        catch (Exception ex)
        {
            ShowToast($"同步失败: {ex.Message}", true);
        }
        finally { isSyncing = false; }
    }

    private async void ShowToast(string message, bool isError = false)
    {
        toastMessage = message;
        toastIsError = isError;
        StateHasChanged();
        await Task.Delay(3000);
        toastMessage = null;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private record AnalysisSummary(decimal TotalIncome, decimal TotalExpense, decimal Balance, int TransactionCount);
    private record CategoryStatDto(string CategoryName, string Icon, decimal Amount, int Count, double Percentage);
    private record MonthlyTrendDto(string Month, decimal Income, decimal Expense);
    private record MerchantRankDto(string Merchant, decimal Amount, int Count);
    private record NetWorthDto(decimal Total, List<NetWorthItemDto> Accounts);
    private record NetWorthItemDto(string AccountName, decimal Balance);
    private record CashFlowDto(string Month, decimal Inflow, decimal Outflow, decimal Net);
    private record DimensionMonthStatDto(string Name, string Month, decimal Amount, int Count);
    private record CategoryTagCellDto(string CategoryName, string TagName, decimal Amount, int Count);
}
