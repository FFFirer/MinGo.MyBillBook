@page "/categories"
@using System.Net.Http.Json
@using MinGo.MyBillBook.Core.Models
@inject HttpClient Http

<PageTitle>消费分类</PageTitle>
<div class="space-y-6">
    <!-- 分类区域 -->
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-800">消费分类</h1>
        <button @onclick="OpenCreateCategoryDialog" class="inline-flex items-center px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors">
            <span class="material-icons mr-2">add</span>
            新增分类
        </button>
    </div>

    @if (errorMessage != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex justify-between items-center">
            <span>@errorMessage</span>
            <button @onclick="() => errorMessage = null" class="text-red-500 hover:text-red-700">
                <span class="material-icons text-lg">close</span>
            </button>
        </div>
    }

    @if (categories != null)
    {
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
            @foreach (var c in categories)
            {
                <div class="bg-white rounded-xl shadow-sm p-4 border border-gray-100 card-hover relative group">
                    <div class="absolute top-2 right-2 hidden group-hover:flex gap-1">
                        <button @onclick="() => OpenEditCategoryDialog(c)" class="p-1 text-gray-400 hover:text-purple-600 transition-colors bg-white rounded" title="编辑">
                            <span class="material-icons text-sm">edit</span>
                        </button>
                        <button @onclick="() => DeleteCategory(c)" class="p-1 text-gray-400 hover:text-red-600 transition-colors bg-white rounded" title="删除">
                            <span class="material-icons text-sm">delete</span>
                        </button>
                    </div>
                    <span class="material-icons text-3xl text-purple-600 block mb-2">@c.Icon</span>
                    <p class="text-sm font-medium text-gray-800">@c.Name</p>
                </div>
            }
        </div>
    }

    <!-- 分类规则区域 -->
    @if (rules != null)
    {
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold">分类规则 (@rules.Count 条)</h2>
                <button @onclick="OpenCreateRuleDialog" class="inline-flex items-center px-3 py-1.5 bg-purple-600 text-white text-sm rounded-lg hover:bg-purple-700 transition-colors">
                    <span class="material-icons mr-1 text-sm">add</span>
                    新增规则
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-200">
                            <th class="text-left py-2 px-3 font-medium text-gray-500">分类</th>
                            <th class="text-left py-2 px-3 font-medium text-gray-500">匹配字段</th>
                            <th class="text-left py-2 px-3 font-medium text-gray-500">匹配模式</th>
                            <th class="text-right py-2 px-3 font-medium text-gray-500">优先级</th>
                            <th class="text-right py-2 px-3 font-medium text-gray-500">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rules)
                        {
                            <tr class="border-b border-gray-100 hover:bg-gray-50">
                                <td class="py-2 px-3">@r.CategoryName</td>
                                <td class="py-2 px-3 text-gray-500">@GetMatchFieldName(r.MatchField)</td>
                                <td class="py-2 px-3 font-mono text-xs">@r.MatchPattern</td>
                                <td class="py-2 px-3 text-right">@r.Priority</td>
                                <td class="py-2 px-3 text-right">
                                    <div class="flex justify-end gap-1">
                                        <button @onclick="() => OpenEditRuleDialog(r)" class="p-1 text-gray-400 hover:text-purple-600 transition-colors" title="编辑">
                                            <span class="material-icons text-lg">edit</span>
                                        </button>
                                        <button @onclick="() => DeleteRule(r)" class="p-1 text-gray-400 hover:text-red-600 transition-colors" title="删除">
                                            <span class="material-icons text-lg">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- 删除确认弹窗 -->
@if (confirmDeleteName != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="CancelDelete">
        <div class="bg-white rounded-xl shadow-xl p-6 max-w-sm w-full mx-4" @onclick:stopPropagation>
            <div class="flex items-center mb-4">
                <div class="p-2 rounded-lg bg-red-100 mr-3">
                    <span class="material-icons text-red-600">warning</span>
                </div>
                <h2 class="text-lg font-semibold text-gray-800">确认删除</h2>
            </div>
            <p class="text-gray-600 mb-6">确定要删除@(confirmDeleteIsRule ? "规则" : "分类")「<strong>@confirmDeleteName</strong>」吗？此操作不可撤销。</p>
            <div class="flex justify-end gap-3">
                <button @onclick="CancelDelete" class="px-4 py-2 text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">取消</button>
                <button @onclick="ConfirmDelete" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">确认删除</button>
            </div>
        </div>
    </div>
}

<!-- 分类新增/编辑弹窗 -->
@if (showCategoryDialog)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="CloseCategoryDialog">
        <div class="bg-white rounded-xl shadow-xl p-6 max-w-md w-full mx-4" @onclick:stopPropagation>
            <h2 class="text-lg font-semibold text-gray-800 mb-4">@(editingCategoryId.HasValue ? "编辑分类" : "新增分类")</h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">名称</label>
                    <input @bind="catFormName" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="如：餐饮" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">图标（Material Icons 名称）</label>
                    <input @bind="catFormIcon" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="如：restaurant" />
                    @if (!string.IsNullOrWhiteSpace(catFormIcon))
                    {
                        <div class="mt-2 flex items-center gap-2">
                            <span class="material-icons text-purple-600">@catFormIcon</span>
                            <span class="text-xs text-gray-500">预览</span>
                        </div>
                    }
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">排序序号</label>
                    <input @bind="catFormSortOrder" type="number" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">父分类（可选）</label>
                    <select @bind="catFormParentId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                        <option value="">无（一级分类）</option>
                        @if (categories != null)
                        {
                            @foreach (var c in categories.Where(x => x.ParentId == null))
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-6">
                <button @onclick="CloseCategoryDialog" class="px-4 py-2 text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">取消</button>
                <button @onclick="SaveCategory" disabled="@isSaving" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors disabled:opacity-50">
                    @(isSaving ? "保存中..." : "保存")
                </button>
            </div>
        </div>
    </div>
}

<!-- 规则新增/编辑弹窗 -->
@if (showRuleDialog)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="CloseRuleDialog">
        <div class="bg-white rounded-xl shadow-xl p-6 max-w-md w-full mx-4" @onclick:stopPropagation>
            <h2 class="text-lg font-semibold text-gray-800 mb-4">@(editingRuleId.HasValue ? "编辑规则" : "新增规则")</h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">分类</label>
                    <select @bind="ruleFormCategoryId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                        <option value="0">请选择分类</option>
                        @if (categories != null)
                        {
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">匹配字段</label>
                    <select @bind="ruleFormMatchField" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                        @foreach (var field in Enum.GetValues<MatchField>())
                        {
                            <option value="@((int)field)">@GetMatchFieldName((int)field)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">匹配模式（关键词）</label>
                    <input @bind="ruleFormMatchPattern" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="如：美团" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">优先级</label>
                    <input @bind="ruleFormPriority" type="number" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" />
                    <p class="text-xs text-gray-500 mt-1">数值越大优先级越高</p>
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-6">
                <button @onclick="CloseRuleDialog" class="px-4 py-2 text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">取消</button>
                <button @onclick="SaveRule" disabled="@isSaving" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors disabled:opacity-50">
                    @(isSaving ? "保存中..." : "保存")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoryDto>? categories;
    private List<RuleDto>? rules;
    private bool showCategoryDialog;
    private bool showRuleDialog;
    private int? editingCategoryId;
    private int? editingRuleId;
    private int? confirmDeleteId;
    private string? confirmDeleteName;
    private bool confirmDeleteIsRule;
    private bool isSaving;
    private string? errorMessage;

    // 分类表单字段
    private string catFormName = string.Empty;
    private string catFormIcon = string.Empty;
    private int catFormSortOrder;
    private int? catFormParentId;

    // 规则表单字段
    private int ruleFormCategoryId;
    private int ruleFormMatchField;
    private string ruleFormMatchPattern = string.Empty;
    private int ruleFormPriority;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories");
        rules = await Http.GetFromJsonAsync<List<RuleDto>>("api/category-rules");
    }

    // === 分类操作 ===
    private void OpenCreateCategoryDialog()
    {
        editingCategoryId = null;
        catFormName = string.Empty;
        catFormIcon = string.Empty;
        catFormSortOrder = (categories?.Max(c => c.SortOrder) ?? 0) + 1;
        catFormParentId = null;
        errorMessage = null;
        showCategoryDialog = true;
    }

    private void OpenEditCategoryDialog(CategoryDto c)
    {
        editingCategoryId = c.Id;
        catFormName = c.Name;
        catFormIcon = c.Icon;
        catFormSortOrder = c.SortOrder;
        catFormParentId = c.ParentId;
        errorMessage = null;
        showCategoryDialog = true;
    }

    private void CloseCategoryDialog()
    {
        showCategoryDialog = false;
        editingCategoryId = null;
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(catFormName))
        {
            errorMessage = "分类名称为必填项";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            var payload = new { Name = catFormName, Icon = catFormIcon, ParentId = catFormParentId, SortOrder = catFormSortOrder };

            if (editingCategoryId.HasValue)
            {
                var response = await Http.PutAsJsonAsync($"api/categories/{editingCategoryId.Value}", payload);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "保存失败";
                    return;
                }
            }
            else
            {
                var response = await Http.PostAsJsonAsync("api/categories", payload);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "创建失败";
                    return;
                }
            }

            CloseCategoryDialog();
            await LoadData();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteCategory(CategoryDto c)
    {
        confirmDeleteId = c.Id;
        confirmDeleteName = c.Name;
        confirmDeleteIsRule = false;
    }

    private void CancelDelete()
    {
        confirmDeleteId = null;
        confirmDeleteName = null;
        confirmDeleteIsRule = false;
    }

    private async Task ConfirmDelete()
    {
        if (confirmDeleteId == null) return;
        var url = confirmDeleteIsRule ? $"api/category-rules/{confirmDeleteId}" : $"api/categories/{confirmDeleteId}";
        var response = await Http.DeleteAsync(url);
        if (response.IsSuccessStatusCode)
        {
            await LoadData();
        }
        else
        {
            var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            errorMessage = error?.Message ?? "删除失败";
        }
        CancelDelete();
    }

    // === 规则操作 ===
    private void OpenCreateRuleDialog()
    {
        editingRuleId = null;
        ruleFormCategoryId = categories?.FirstOrDefault()?.Id ?? 0;
        ruleFormMatchField = 0;
        ruleFormMatchPattern = string.Empty;
        ruleFormPriority = 0;
        errorMessage = null;
        showRuleDialog = true;
    }

    private void OpenEditRuleDialog(RuleDto r)
    {
        editingRuleId = r.Id;
        ruleFormCategoryId = r.CategoryId;
        ruleFormMatchField = r.MatchField;
        ruleFormMatchPattern = r.MatchPattern;
        ruleFormPriority = r.Priority;
        errorMessage = null;
        showRuleDialog = true;
    }

    private void CloseRuleDialog()
    {
        showRuleDialog = false;
        editingRuleId = null;
    }

    private async Task SaveRule()
    {
        if (ruleFormCategoryId == 0)
        {
            errorMessage = "请选择分类";
            return;
        }
        if (string.IsNullOrWhiteSpace(ruleFormMatchPattern))
        {
            errorMessage = "匹配模式为必填项";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            var payload = new { CategoryId = ruleFormCategoryId, MatchField = ruleFormMatchField, MatchPattern = ruleFormMatchPattern, Priority = ruleFormPriority };

            if (editingRuleId.HasValue)
            {
                var response = await Http.PutAsJsonAsync($"api/category-rules/{editingRuleId.Value}", payload);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "保存失败";
                    return;
                }
            }
            else
            {
                var response = await Http.PostAsJsonAsync("api/category-rules", payload);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "创建失败";
                    return;
                }
            }

            CloseRuleDialog();
            await LoadData();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteRule(RuleDto r)
    {
        confirmDeleteId = r.Id;
        confirmDeleteName = r.CategoryName + " - " + r.MatchPattern;
        confirmDeleteIsRule = true;
    }

    private static string GetMatchFieldName(int field) => field switch
    {
        0 => "交易对方",
        1 => "商品名称",
        2 => "商户",
        _ => "未知"
    };

    private record CategoryDto(int Id, string Name, string Icon, int? ParentId, int SortOrder);
    private record RuleDto(int Id, int CategoryId, string CategoryName, int MatchField, string MatchPattern, int Priority, bool IsActive);
    private record ErrorResponse(string Message);
}
