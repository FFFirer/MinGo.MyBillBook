@page "/"

<PageTitle>个人财务分析</PageTitle>

<div class="space-y-4 sm:space-y-6">
    <div class="page-header">
        <h1>个人财务分析</h1>
    </div>

    <div class="grid metric-grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        <div class="md-card-elevated p-4 sm:p-6 card-hover">
            <div class="flex items-center">
                <div class="p-3 rounded-md bg-success-container mr-4 shrink-0">
                    <span class="material-symbols-outlined text-success" style="font-size:1.5rem;">trending_up</span>
                </div>
                <div class="min-w-0">
                    <p class="text-body-small text-on-surface-variant">本月收入</p>
                    <p class="text-headline-small font-medium text-success tabular-nums truncate">--</p>
                </div>
            </div>
        </div>

        <div class="md-card-elevated p-4 sm:p-6 card-hover">
            <div class="flex items-center">
                <div class="p-3 rounded-md bg-error-container mr-4 shrink-0">
                    <span class="material-symbols-outlined text-error" style="font-size:1.5rem;">trending_down</span>
                </div>
                <div class="min-w-0">
                    <p class="text-body-small text-on-surface-variant">本月支出</p>
                    <p class="text-headline-small font-medium text-error tabular-nums truncate">--</p>
                </div>
            </div>
        </div>

        <div class="md-card-elevated p-4 sm:p-6 card-hover">
            <div class="flex items-center">
                <div class="p-3 rounded-md bg-primary-container mr-4 shrink-0">
                    <span class="material-symbols-outlined text-primary" style="font-size:1.5rem;">account_balance_wallet</span>
                </div>
                <div class="min-w-0">
                    <p class="text-body-small text-on-surface-variant">本月结余</p>
                    <p class="text-headline-small font-medium text-primary tabular-nums truncate">--</p>
                </div>
            </div>
        </div>
    </div>

    <div class="md-card-elevated p-4 sm:p-6">
        <h2 class="text-title-large mb-4 text-on-surface">快速操作</h2>
        <div class="grid grid-cols-1 sm:flex sm:flex-wrap gap-3">
            <a href="import" class="md-btn-filled">
                <span class="material-symbols-outlined">upload_file</span>
                <span>导入对账单</span>
            </a>
            <a href="bills" class="md-btn-outlined">
                <span class="material-symbols-outlined">receipt_long</span>
                <span>查看账单</span>
            </a>
            <a href="analysis" class="md-btn-outlined">
                <span class="material-symbols-outlined">analytics</span>
                <span>消费分析</span>
            </a>
        </div>
    </div>
</div>
