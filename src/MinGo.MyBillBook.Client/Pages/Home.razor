@page "/"

<PageTitle>个人财务分析</PageTitle>

<div class="space-y-6">
    <h1 class="text-2xl font-bold text-gray-800">个人财务分析</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <div class="flex items-center">
                <div class="p-3 rounded-lg bg-green-100 mr-4">
                    <span class="material-icons text-green-600">trending_up</span>
                </div>
                <div>
                    <p class="text-sm text-gray-500">本月收入</p>
                    <p class="text-2xl font-bold text-green-600">--</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <div class="flex items-center">
                <div class="p-3 rounded-lg bg-red-100 mr-4">
                    <span class="material-icons text-red-600">trending_down</span>
                </div>
                <div>
                    <p class="text-sm text-gray-500">本月支出</p>
                    <p class="text-2xl font-bold text-red-600">--</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <div class="flex items-center">
                <div class="p-3 rounded-lg bg-purple-100 mr-4">
                    <span class="material-icons text-purple-600">account_balance_wallet</span>
                </div>
                <div>
                    <p class="text-sm text-gray-500">本月结余</p>
                    <p class="text-2xl font-bold text-purple-600">--</p>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">快速操作</h2>
        <div class="flex flex-wrap gap-4">
            <a href="import" class="inline-flex items-center px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors">
                <span class="material-icons mr-2">upload_file</span>
                导入对账单
            </a>
            <a href="bills" class="inline-flex items-center px-4 py-2 bg-white text-purple-600 border border-purple-200 rounded-lg hover:bg-purple-50 transition-colors">
                <span class="material-icons mr-2">receipt_long</span>
                查看账单
            </a>
            <a href="analysis" class="inline-flex items-center px-4 py-2 bg-white text-purple-600 border border-purple-200 rounded-lg hover:bg-purple-50 transition-colors">
                <span class="material-icons mr-2">analytics</span>
                消费分析
            </a>
        </div>
    </div>
</div>
