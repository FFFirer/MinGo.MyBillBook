    private async Task LoadTodosAsync(bool silent = false)
    {
        try
        {
            var list = await Http.GetFromJsonAsync<List<TodoDto>>("api/inbox/todos?status=Pending") ?? [];

            // 保留已输入但尚未提交的内容，避免轮询覆盖用户输入。
            foreach (var item in todos)
                todoValueCache[item.Dto.Id] = item.Value;

            todos = list.Select(dto => new TodoItem
            {
                Dto = dto,
                Value = todoValueCache.TryGetValue(dto.Id, out var cached) ? cached : null
            }).ToList();
        }
        catch (Exception ex)
        {
            if (!silent)
                ShowToast($"加载待办失败：{ex.Message}", true);
        }
    }

    private async Task LoadRunsAsync(bool silent = false)
    {
        try
        {
            var result = await Http.GetFromJsonAsync<PagedRunsDto>(
                $"api/inbox/runs?page={runsPage}&pageSize={PageSize}");
            if (result is null)
                return;

            runs = result.Items;
            runsTotal = result.TotalCount;

            if (runs.Count == 0 && runsPage > 1)
            {
                runsPage--;
                await LoadRunsAsync(silent);
            }
        }
        catch (Exception ex)
        {
            if (!silent)
                ShowToast($"加载运行记录失败：{ex.Message}", true);
        }
    }

