    private async Task CompleteTodoAsync(TodoItem item)
    {
        if (busyTodoIds.Contains(item.Dto.Id))
            return;

        var value = item.Value;
        if (item.Dto.InputType == "confirm" && string.IsNullOrWhiteSpace(value))
            value = "已确认";

        busyTodoIds.Add(item.Dto.Id);
        try
        {
            var resp = await Http.PostAsJsonAsync(
                $"api/inbox/todos/{item.Dto.Id}/complete", new { value });

            if (resp.IsSuccessStatusCode)
            {
                todoValueCache.Remove(item.Dto.Id);
                ShowToast("已提交，工作流将在数秒内继续");
                await LoadTodosAsync();
                await LoadRunsAsync(silent: true);
                if (expandedRunId == item.Dto.RunId)
                    await LoadRunDetailAsync(item.Dto.RunId, silent: true);
            }
            else
            {
                ShowToast($"提交失败：{await ReadErrorAsync(resp)}", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"提交异常：{ex.Message}", true);
        }
        finally
        {
            busyTodoIds.Remove(item.Dto.Id);
        }
    }

    private void OpenCancelDialog(RunDto run) => cancelRun = run;

    private void CloseCancelDialog()
    {
        if (!cancelling)
            cancelRun = null;
    }

    private async Task ConfirmCancelAsync()
    {
        if (cancelRun is null)
            return;

        cancelling = true;
        try
        {
            var resp = await Http.PostAsync($"api/inbox/runs/{cancelRun.Id}/cancel", null);
            if (resp.IsSuccessStatusCode)
            {
                ShowToast("运行已取消");
                cancelRun = null;
                await LoadRunsAsync();
                await LoadTodosAsync();
                if (expandedRunId.HasValue)
                    await LoadRunDetailAsync(expandedRunId.Value, silent: true);
            }
            else
            {
                ShowToast($"取消失败：{await ReadErrorAsync(resp)}", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"取消异常：{ex.Message}", true);
        }
        finally
        {
            cancelling = false;
        }
    }

    private void ShowToast(string message, bool isError = false)
    {
        _ = toastRef?.Show(message, isError);
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage resp)
    {
        try
        {
            var body = await resp.Content.ReadAsStringAsync();
            using var doc = JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("message", out var message))
                return message.GetString() ?? $"HTTP {(int)resp.StatusCode}";
            return body.Length > 0 ? body : $"HTTP {(int)resp.StatusCode}";
        }
        catch
        {
            return $"HTTP {(int)resp.StatusCode}";
        }
    }

