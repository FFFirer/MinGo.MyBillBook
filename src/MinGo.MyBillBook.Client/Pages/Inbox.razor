    }

    private async Task TriggerRunAsync()
    {
        if (pendingWorkflow is null)
            return;

        triggering = true;
        triggerError = null;

        try
        {
            using var content = new MultipartFormDataContent();
            if (pendingWorkflowFile is not null)
            {
                var stream = pendingWorkflowFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/octet-stream");
                content.Add(fileContent, "file", pendingWorkflowFile.Name);
            }

            var url = $"api/inbox/workflows/{Uri.EscapeDataString(pendingWorkflow.Name)}/runs";
            var resp = await Http.PostAsync(url, content);

            if (resp.IsSuccessStatusCode)
            {
                showTriggerDialog = false;
                pendingWorkflow = null;
                pendingWorkflowFile = null;
                ShowToast("已触发运行，后台将自动推进");
                runsPage = 1;
                await LoadRunsAsync();
                await LoadTodosAsync();
            }
            else
            {
                triggerError = await ReadErrorAsync(resp);
            }
        }
        catch (Exception ex)
        {
            triggerError = $"触发异常：{ex.Message}";
        }
        finally
        {
            triggering = false;
        }
    }

