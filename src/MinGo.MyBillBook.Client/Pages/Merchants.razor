@page "/merchants"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>商户归一化</PageTitle>
<div class="space-y-4 sm:space-y-6">
    <div class="page-header">
        <h1>商户归一化</h1>
        <div class="actions w-full sm:w-auto">
            <button @onclick="OpenAliasDialog" class="flex-1 sm:flex-none md-btn-tonal state-layer">
                <span class="material-symbols-outlined mr-1 sm:mr-2">rule</span><span class="hidden xs:inline">新增别名</span><span class="xs:hidden">别名</span>
            </button>
            <button @onclick="OpenMerchantDialog" class="flex-1 sm:flex-none md-btn-filled state-layer">
                <span class="material-symbols-outlined mr-1 sm:mr-2">add</span><span class="hidden xs:inline">新增商户</span><span class="xs:hidden">商户</span>
            </button>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="bg-error-container text-on-error-container px-4 py-3 rounded-md flex justify-between items-start gap-3" role="alert">
            <span class="flex-1 text-body-medium break-words">@errorMessage</span>
            <button @onclick="() => errorMessage = null" class="md-icon-btn shrink-0" aria-label="关闭">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }

    <!-- 商户列表 -->
    <div class="md-card-elevated overflow-hidden">
        <div class="card-header">
            <span class="material-symbols-outlined card-header-icon">storefront</span>
            <h2 class="card-header-title">商户</h2>
            <span class="md-chip md-chip-assist-primary text-body-small">@(merchants?.Count ?? 0)</span>
        </div>

        @if (merchants == null)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">loading_spinner</span>
                <p>加载中...</p>
            </div>
        }
        else if (merchants.Count == 0)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">storefront</span>
                <p class="text-body-medium">暂无商户</p>
                <p class="text-body-small mt-1">点击上方「新增商户」创建第一个商户</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="md-table responsive-cards">
                    <thead>
                        <tr>
                            <th class="text-left">规范名称</th>
                            <th class="text-left">默认分类</th>
                            <th class="text-left hide-mobile">别名数</th>
                            <th class="text-left">关联账单</th>
                            <th class="text-right">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in PagedMerchants)
                        {
                            <tr>
                                <td data-label="规范名称" class="font-medium text-on-surface wrap-cell"><span class="break-words">@m.CanonicalName</span></td>
                                <td data-label="默认分类" class="text-on-surface-variant">@(m.DefaultCategoryName ?? "—")</td>
                                <td data-label="别名数" class="tabular-nums hide-mobile">
                                    @if (m.AliasCount > 0)
                                    {
                                        <span class="md-chip md-chip-assist-info">@m.AliasCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-on-surface-variant">0</span>
                                    }
                                </td>
                                <td data-label="关联账单">
                                    @if (m.BillCount > 0)
                                    {
                                        <a href="@($"bills?keyword={Uri.EscapeDataString(m.CanonicalName)}")" title="查看该商户的关联账单"
                                           class="md-chip md-chip-assist-primary hover:bg-primary-container/80 transition-colors">
                                            <span class="material-symbols-outlined" style="font-size:16px;">receipt_long</span><span class="tabular-nums">@m.BillCount</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-outline-variant">—</span>
                                    }
                                </td>
                                <td data-label="操作" class="text-right">
                                    <div class="inline-flex items-center justify-end gap-1">
                                        <button @onclick="() => OpenEditMerchantDialog(m)" class="md-icon-btn" title="编辑" aria-label="编辑 @m.CanonicalName"><span class="material-symbols-outlined">edit</span></button>
                                        <button @onclick="() => ConfirmDeleteMerchant(m)" class="md-icon-btn" title="删除" aria-label="删除 @m.CanonicalName"><span class="material-symbols-outlined text-error">delete</span></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Paginator TotalCount="@(merchants?.Count ?? 0)" PageSize="PageSize" @bind-Page="merchantsPage" />
        }
    </div>

    <!-- 别名规则列表 -->
    <div class="md-card-elevated overflow-hidden">
        <div class="card-header">
            <span class="material-symbols-outlined card-header-icon">rule</span>
            <h2 class="card-header-title">别名规则</h2>
            <span class="card-header-subtitle hidden sm:inline">（按优先级降序匹配）</span>
            <span class="md-chip md-chip-assist-primary text-body-small">@(aliases?.Count ?? 0)</span>
        </div>

        @if (aliases == null)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">loading_spinner</span>
                <p>加载中...</p>
            </div>
        }
        else if (aliases.Count == 0)
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">rule</span>
                <p class="text-body-medium">暂无别名规则</p>
                <p class="text-body-small mt-1">点击上方「新增别名」创建别名匹配规则</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="md-table responsive-cards">
                    <thead>
                        <tr>
                            <th class="text-left">模式</th>
                            <th class="text-left">匹配方式</th>
                            <th class="text-left">归一到</th>
                            <th class="text-left hide-mobile">优先级</th>
                            <th class="text-left hide-mobile">启用</th>
                            <th class="text-right">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in PagedAliases)
                        {
                            <tr>
                                <td data-label="模式" class="font-mono wrap-cell"><span class="break-all text-body-small text-on-surface">@a.Pattern</span></td>
                                <td data-label="匹配方式">
                                    <span title="@MatchTypeHint(a.MatchType)" class="md-chip @MatchTypeBadgeClass(a.MatchType)">
                                        <span class="material-symbols-outlined" style="font-size:16px;">@MatchTypeIcon(a.MatchType)</span>@MatchTypeLabel(a.MatchType)
                                    </span>
                                </td>
                                <td data-label="归一到" class="text-on-surface wrap-cell"><span class="break-words">@a.MerchantName</span></td>
                                <td data-label="优先级" class="tabular-nums text-on-surface-variant hide-mobile">@a.Priority</td>
                                <td data-label="启用" class="hide-mobile">
                                    @if (a.IsActive)
                                    {
                                        <span class="md-chip md-chip-assist-success">启用</span>
                                    }
                                    else
                                    {
                                        <span class="md-chip md-chip-assist-error">停用</span>
                                    }
                                </td>
                                <td data-label="操作" class="text-right">
                                    <div class="inline-flex items-center justify-end gap-1">
                                        <button @onclick="() => OpenEditAliasDialog(a)" class="md-icon-btn" title="编辑" aria-label="编辑别名 @a.Pattern"><span class="material-symbols-outlined">edit</span></button>
                                        <button @onclick="() => ConfirmDeleteAlias(a)" class="md-icon-btn" title="删除" aria-label="删除别名 @a.Pattern"><span class="material-symbols-outlined text-error">delete</span></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Paginator TotalCount="@(aliases?.Count ?? 0)" PageSize="PageSize" @bind-Page="aliasesPage" />
        }
    </div>
</div>

<!-- 删除确认弹窗 -->
@if (confirmDeleteItem != null)
{
    <div class="modal-root" @onclick="CancelDelete" role="alertdialog" aria-modal="true" aria-label="确认删除">
        <div class="modal-panel modal-sm" @onclick:stopPropagation>
            <div class="flex items-center mb-4">
                <div class="p-2 rounded-md bg-error-container mr-3 shrink-0">
                    <span class="material-symbols-outlined text-error">warning</span>
                </div>
                <h2 class="text-title-large text-on-surface">确认删除</h2>
            </div>
            <p class="text-body-medium text-on-surface-variant mb-6">
                确定要删除@(confirmDeleteItem.IsAlias ? "别名规则" : "商户")「<strong class="text-on-surface">@confirmDeleteItem.Name</strong>」吗？此操作不可撤销。
            </p>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3">
                <button @onclick="CancelDelete" class="md-btn-outlined state-layer w-full sm:w-auto">取消</button>
                <button @onclick="ExecuteDelete" class="md-btn-danger state-layer w-full sm:w-auto">确认删除</button>
            </div>
        </div>
    </div>
}

<!-- 商户新增/编辑弹窗 -->
@if (showMerchantDialog)
{
    <div class="modal-root" @onclick="CloseMerchantDialog" role="dialog" aria-modal="true" aria-label="@(editingMerchantId.HasValue ? "编辑商户" : "新增商户")">
        <div class="modal-panel modal-sm" @onclick:stopPropagation>
            <div class="flex items-center mb-4">
                <div class="p-2 rounded-md bg-primary-container mr-3 shrink-0">
                    <span class="material-symbols-outlined text-on-primary-container">storefront</span>
                </div>
                <h2 class="text-title-large text-on-surface">@(editingMerchantId.HasValue ? "编辑商户" : "新增商户")</h2>
            </div>
            <div class="space-y-4">
                <div>
                    <label for="merchantNameInput" class="block text-body-small text-on-surface-variant mb-1">规范名称</label>
                    <input id="merchantNameInput" @bind="merchantName" class="md-text-field-outlined w-full" placeholder="如：星巴克" />
                </div>
                <div>
                    <label for="merchantCatSelect" class="block text-body-small text-on-surface-variant mb-1">默认分类（MerchantRule 层）</label>
                    <select id="merchantCatSelect" @bind="merchantDefaultCategoryId" class="md-text-field-outlined w-full">
                        <option value="0">— 无（走兜底分类）—</option>
                        @if (categories != null)
                        {
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3 mt-6">
                <button @onclick="CloseMerchantDialog" class="md-btn-outlined state-layer w-full sm:w-auto">取消</button>
                <button @onclick="SaveMerchant" disabled="@isSaving" class="md-btn-filled state-layer w-full sm:w-auto">@(isSaving ? "保存中…" : "保存")</button>
            </div>
        </div>
    </div>
}

<!-- 别名新增/编辑弹窗 -->
@if (showAliasDialog)
{
    <div class="modal-root" @onclick="CloseAliasDialog" role="dialog" aria-modal="true" aria-label="@(editingAliasId.HasValue ? "编辑别名" : "新增别名")">
        <div class="modal-panel modal-sm" @onclick:stopPropagation>
            <div class="flex items-center mb-4">
                <div class="p-2 rounded-md bg-secondary-container mr-3 shrink-0">
                    <span class="material-symbols-outlined text-on-secondary-container">rule</span>
                </div>
                <h2 class="text-title-large text-on-surface">@(editingAliasId.HasValue ? "编辑别名" : "新增别名")</h2>
            </div>
            <div class="space-y-4">
                <div>
                    <label for="aliasPatternInput" class="block text-body-small text-on-surface-variant mb-1">模式</label>
                    <input id="aliasPatternInput" @bind="aliasPattern" class="md-text-field-outlined w-full" placeholder="如：STARBUCKS" />
                </div>
                <div>
                    <label for="aliasMatchSelect" class="block text-body-small text-on-surface-variant mb-1">匹配方式</label>
                    <select id="aliasMatchSelect" @bind="aliasMatchType" class="md-text-field-outlined w-full">
                        <option value="1">包含（Contains）</option>
                        <option value="2">精确（Exact）</option>
                        <option value="0">正则（Regex）</option>
                    </select>
                </div>
                <div>
                    <label for="aliasMerchantSelect" class="block text-body-small text-on-surface-variant mb-1">归一到商户</label>
                    <select id="aliasMerchantSelect" @bind="aliasMerchantId" class="md-text-field-outlined w-full">
                        <option value="0">— 请选择 —</option>
                        @if (merchants != null)
                        {
                            @foreach (var m in merchants)
                            {
                                <option value="@m.Id">@m.CanonicalName</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label for="aliasPriorityInput" class="block text-body-small text-on-surface-variant mb-1">优先级</label>
                    <input id="aliasPriorityInput" type="number" @bind="aliasPriority" class="md-text-field-outlined w-full" />
                    <p class="text-body-small text-on-surface-variant mt-1">数值越大优先级越高</p>
                </div>
                <label class="flex items-center gap-2 text-body-medium text-on-surface min-h-[44px] cursor-pointer">
                    <input type="checkbox" @bind="aliasIsActive" class="w-5 h-5 rounded border-outline text-primary focus:ring-primary/40" /> 启用
                </label>
            </div>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3 mt-6">
                <button @onclick="CloseAliasDialog" class="md-btn-outlined state-layer w-full sm:w-auto">取消</button>
                <button @onclick="SaveAlias" disabled="@isSaving" class="md-btn-filled state-layer w-full sm:w-auto">@(isSaving ? "保存中…" : "保存")</button>
            </div>
        </div>
    </div>
}

@code {
    private List<MerchantDto>? merchants;
    private List<AliasDto>? aliases;
    private List<CategoryOption>? categories;
    private int merchantsPage = 1;
    private int aliasesPage = 1;
    private const int PageSize = 20;
    private IEnumerable<MerchantDto> PagedMerchants => merchants?.Skip((merchantsPage - 1) * PageSize).Take(PageSize) ?? [];
    private IEnumerable<AliasDto> PagedAliases => aliases?.Skip((aliasesPage - 1) * PageSize).Take(PageSize) ?? [];
    private bool showMerchantDialog, showAliasDialog, isSaving;
    private string? errorMessage;

    private int? editingMerchantId;
    private string merchantName = string.Empty;
    private int merchantDefaultCategoryId;

    private int? editingAliasId;
    private string aliasPattern = string.Empty;
    private int aliasMatchType = 1;
    private int aliasMerchantId;
    private int aliasPriority;
    private bool aliasIsActive = true;

    private ConfirmDeleteItem? confirmDeleteItem;

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        merchants = await Http.GetFromJsonAsync<List<MerchantDto>>("api/merchants");
        aliases = await Http.GetFromJsonAsync<List<AliasDto>>("api/merchant-aliases");
        categories = await Http.GetFromJsonAsync<List<CategoryOption>>("api/categories");
    }

    // === 商户 ===
    private void OpenMerchantDialog() { editingMerchantId = null; merchantName = string.Empty; merchantDefaultCategoryId = 0; errorMessage = null; showMerchantDialog = true; }
    private void OpenEditMerchantDialog(MerchantDto m) { editingMerchantId = m.Id; merchantName = m.CanonicalName; merchantDefaultCategoryId = m.DefaultCategoryId ?? 0; errorMessage = null; showMerchantDialog = true; }
    private void CloseMerchantDialog() { showMerchantDialog = false; editingMerchantId = null; }

    private async Task SaveMerchant()
    {
        if (string.IsNullOrWhiteSpace(merchantName)) { errorMessage = "规范名称为必填项"; return; }
        isSaving = true; errorMessage = null;
        try
        {
            var payload = new { CanonicalName = merchantName, DefaultCategoryId = (int?)((merchantDefaultCategoryId == 0) ? null : merchantDefaultCategoryId) };
            var resp = editingMerchantId.HasValue
                ? await Http.PutAsJsonAsync($"api/merchants/{editingMerchantId.Value}", payload)
                : await Http.PostAsJsonAsync("api/merchants", payload);
            if (!resp.IsSuccessStatusCode) { errorMessage = "保存失败"; return; }
            CloseMerchantDialog();
            await LoadAll();
        }
        finally { isSaving = false; }
    }

    private void ConfirmDeleteMerchant(MerchantDto m)
    {
        confirmDeleteItem = new ConfirmDeleteItem(m.Id, m.CanonicalName, false);
    }

    // === 别名 ===
    private void OpenAliasDialog()
    {
        editingAliasId = null; aliasPattern = string.Empty; aliasMatchType = 1; aliasMerchantId = 0; aliasPriority = 0; aliasIsActive = true;
        errorMessage = null; showAliasDialog = true;
    }
    private void OpenEditAliasDialog(AliasDto a)
    {
        editingAliasId = a.Id; aliasPattern = a.Pattern; aliasMatchType = (int)a.MatchType; aliasMerchantId = a.MerchantId;
        aliasPriority = a.Priority; aliasIsActive = a.IsActive; errorMessage = null; showAliasDialog = true;
    }
    private void CloseAliasDialog() { showAliasDialog = false; editingAliasId = null; }

    private async Task SaveAlias()
    {
        if (string.IsNullOrWhiteSpace(aliasPattern) || aliasMerchantId == 0) { errorMessage = "模式与目标商户为必填项"; return; }
        isSaving = true; errorMessage = null;
        try
        {
            var payload = new { Pattern = aliasPattern, MatchType = aliasMatchType, MerchantId = aliasMerchantId, Priority = aliasPriority, IsActive = aliasIsActive };
            var resp = editingAliasId.HasValue
                ? await Http.PutAsJsonAsync($"api/merchant-aliases/{editingAliasId.Value}", payload)
                : await Http.PostAsJsonAsync("api/merchant-aliases", payload);
            if (!resp.IsSuccessStatusCode) { errorMessage = "保存失败"; return; }
            CloseAliasDialog();
            await LoadAll();
        }
        finally { isSaving = false; }
    }

    private void ConfirmDeleteAlias(AliasDto a)
    {
        confirmDeleteItem = new ConfirmDeleteItem(a.Id, $"{a.Pattern} → {a.MerchantName}", true);
    }

    // === 删除确认 ===
    private void CancelDelete() { confirmDeleteItem = null; }

    private async Task ExecuteDelete()
    {
        if (confirmDeleteItem == null) return;
        var url = confirmDeleteItem.IsAlias ? $"api/merchant-aliases/{confirmDeleteItem.Id}" : $"api/merchants/{confirmDeleteItem.Id}";
        var resp = await Http.DeleteAsync(url);
        if (resp.IsSuccessStatusCode)
        {
            await LoadAll();
        }
        else
        {
            errorMessage = confirmDeleteItem.IsAlias ? "删除别名失败" : $"删除「{confirmDeleteItem.Name}」失败";
        }
        CancelDelete();
    }

    // === 匹配方式展示 ===
    private static string MatchTypeLabel(int matchType) => matchType switch
    {
        0 => "正则",
        1 => "包含",
        2 => "精确",
        _ => "未知"
    };

    private static string MatchTypeIcon(int matchType) => matchType switch
    {
        0 => "code",
        1 => "find_in_page",
        2 => "equal",
        _ => "help_outline"
    };

    private static string MatchTypeBadgeClass(int matchType) => matchType switch
    {
        0 => "md-chip-assist-primary",
        1 => "md-chip-assist-info",
        2 => "md-chip-assist-success",
        _ => "md-chip-assist-info"
    };

    private static string MatchTypeHint(int matchType) => matchType switch
    {
        0 => "按正则表达式匹配（忽略大小写）",
        1 => "商户名包含该模式即命中（忽略大小写）",
        2 => "与商户名完全一致才命中（忽略大小写）",
        _ => "未知的匹配方式"
    };

    private record MerchantDto(int Id, string CanonicalName, DateTime CreatedAt, int? DefaultCategoryId, string? DefaultCategoryName, int AliasCount, int BillCount);
    private record AliasDto(int Id, string Pattern, int MatchType, int MerchantId, string MerchantName, int Priority, bool IsActive);
    private record CategoryOption(int Id, string Name);
    private record ConfirmDeleteItem(int Id, string Name, bool IsAlias);
}
