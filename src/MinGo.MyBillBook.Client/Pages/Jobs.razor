@page "/jobs"
@using System.Net.Http.Json
@inject HttpClient Http
@implements IDisposable

<PageTitle>任务与重建</PageTitle>
<div class="space-y-4 sm:space-y-6">
    <div class="page-header">
        <h1>任务与重建</h1>
        <div class="actions">
            <button @onclick="LoadAllAsync" class="md-btn-filled">
                <span class="material-symbols-outlined mr-1">refresh</span>刷新
            </button>
        </div>
    </div>

    <Toast @ref="toastRef" />

    <!-- 触发局部重建 -->
    <div class="md-card-elevated">
        <h2 class="text-title-medium md:text-title-large mb-1">局部重建</h2>
        <p class="text-body-small text-on-surface-variant mb-4">规则变更后从指定步骤起重算 Canonical 层，无需重导 CSV。请求入队后立即返回，由后台 Worker 异步执行。</p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-end gap-3">
            <div class="flex-1 sm:flex-none sm:min-w-[16rem]">
                <label for="fromStepSelect" class="block text-body-small text-on-surface-variant mb-1">起点步骤</label>
                <select id="fromStepSelect" @bind="fromStep" class="md-text-field-outlined w-full">
                    <option value="ReParse">ReParse（从原始文件重解析）</option>
                    <option value="Normalize">Normalize（全量重建）</option>
                    <option value="ResolveMerchant">ResolveMerchant（商户重算）</option>
                    <option value="ClassifyCategory">ClassifyCategory（分类/标签重算）</option>
                </select>
            </div>
            <div class="flex-1 sm:flex-none sm:w-40">
                <label for="batchIdInput" class="block text-body-small text-on-surface-variant mb-1">批次 Id（留空=全部）</label>
                <input id="batchIdInput" type="number" @bind="batchId" placeholder="全部批次"
                       class="md-text-field-outlined w-full" />
            </div>
            <button @onclick="TriggerRebuildAsync" disabled="@busy"
                    class="md-btn-filled w-full sm:w-auto shrink-0">
                <span class="material-symbols-outlined mr-1">build</span>
                @(busy ? "入队中…" : "入队重建")
            </button>
        </div>
    </div>

    <!-- 从原始文件重解析 -->
    <div class="md-card-elevated">
        <h2 class="text-title-medium md:text-title-large mb-1">从原始文件重解析</h2>
        <p class="text-body-small text-on-surface-variant mb-4">从对象存储中读取导入时保存的原始文件，使用当前解析器重新解析并跑完整管道。适用于解析器升级后重跑历史数据。</p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-end gap-3">
            <div class="flex-1 sm:flex-none sm:w-40">
                <label for="reparseBatchIdInput" class="block text-body-small text-on-surface-variant mb-1">批次 Id（留空=全部）</label>
                <input id="reparseBatchIdInput" type="number" @bind="reparseBatchId" placeholder="全部批次"
                       class="md-text-field-outlined w-full" />
            </div>
            <button @onclick="TriggerReParseAsync" disabled="@reparseBusy"
                    class="md-btn-filled w-full sm:w-auto shrink-0">
                <span class="material-symbols-outlined mr-1">restart_alt</span>
                @(reparseBusy ? "入队中…" : "入队重解析")
            </button>
        </div>
    </div>

    <!-- 危险操作：清空数据 -->
    <div class="md-card-elevated" style="border: 1px solid var(--color-error);">
        <h2 class="text-title-medium md:text-title-large mb-1 text-error">清空全部数据</h2>
        <p class="text-body-small text-on-surface-variant mb-4">删除所有账单相关数据（Raw / Normalized / Canonical / 重复候选 / 管道运行记录），但保留分类、商户、标签等规则配置。此操作不可逆。</p>
        <button @onclick="OnClearAllClick" disabled="@clearBusy"
                class="md-btn-danger w-full sm:w-auto">
            <span class="material-symbols-outlined mr-1">delete_forever</span>
            @(clearBusy ? "清空中…" : "清空全部数据")
        </button>
    </div>

    <!-- 确认对话框 -->
    @if (showClearConfirm)
    {
        <div class="modal-root" @onclick="() => showClearConfirm = false">
            <div class="modal-panel modal-sm md-card-elevated" @onclick:stopPropagation>
                <h3 class="text-title-medium text-error mb-2">确认清空</h3>
                <p class="text-body-medium text-on-surface-variant mb-4">
                    此操作将删除所有账单数据，但保留规则配置。<br/>
                    <strong class="text-error">此操作不可逆！</strong>
                </p>
                <div class="flex justify-end gap-2">
                    <button @onclick="() => showClearConfirm = false" class="md-btn-outlined">取消</button>
                    <button @onclick="ConfirmClearAllAsync" class="md-btn-danger">确认清空</button>
                </div>
            </div>
        </div>
    }

    <!-- 任务队列 -->
    <div class="md-card-elevated">
        <h2 class="text-title-medium md:text-title-large mb-4">后台任务</h2>
        @if (jobs == null)
        {
            <p class="text-body-medium text-on-surface-variant flex items-center gap-2"><span class="md-circular-progress"></span>加载中…</p>
        }
        else if (jobs.Count == 0)
        {
            <p class="text-body-medium text-on-surface-variant">暂无任务</p>
        }
        else
        {
            <div class="overflow-x-auto -mx-4 sm:-mx-6">
                <table class="md-table responsive-cards">
                    <thead>
                        <tr>
                            <th class="text-left">Id</th>
                            <th class="text-left">类型</th>
                            <th class="text-left hide-mobile">参数</th>
                            <th class="text-left">状态</th>
                            <th class="text-left hide-mobile">创建</th>
                            <th class="text-left hide-mobile">完成</th>
                            <th class="text-left hide-mobile">错误</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var j in PagedJobs)
                        {
                            <tr>
                                <td data-label="Id" class="tabular-nums text-on-surface">@j.Id</td>
                                <td data-label="类型" class="text-on-surface">@j.Type</td>
                                <td data-label="参数" class="text-on-surface-variant font-mono text-body-small wrap-cell hide-mobile"><span class="break-all">@j.Payload</span></td>
                                <td data-label="状态">
                                    <span class="md-chip @StatusClass(j.Status)">@StatusText(j.Status)</span>
                                </td>
                                <td data-label="创建" class="text-on-surface-variant hide-mobile">@j.CreatedAt.ToString("MM-dd HH:mm:ss")</td>
                                <td data-label="完成" class="text-on-surface-variant hide-mobile">@(j.CompletedAt?.ToString("MM-dd HH:mm:ss") ?? "-")</td>
                                <td data-label="错误" class="text-error text-body-small max-w-xs wrap-cell hide-mobile"><span class="break-words" title="@j.Error">@(j.Error ?? "")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="job-card-list">
                @foreach (var j in PagedJobs)
                {
                    <div class="job-card">
                        <div class="job-card__top">
                            <span class="job-card__type">@j.Type</span>
                            <span class="md-chip @StatusClass(j.Status)" style="height:1.5rem;padding:0 0.5rem;font-size:var(--text-label-small);">@StatusText(j.Status)</span>
                        </div>
                        <div class="job-card__bottom">
                            <span>@j.CreatedAt.ToString("MM-dd HH:mm:ss")</span>
                            @if (j.Error != null)
                            {
                                <span class="job-card__error" title="@j.Error">异常</span>
                            }
                        </div>
                    </div>
                }
            </div>
            <Paginator TotalCount="jobs.Count" PageSize="PageSize" @bind-Page="jobsPage" />
        }
    </div>

    <!-- 统一清洗规则视图 -->
    <div class="md-card-elevated">
        <h2 class="text-title-medium md:text-title-large mb-1">统一清洗规则</h2>
        <p class="text-body-small text-on-surface-variant mb-4">Category / Merchant / Tag 规则收敛视图（按优先级降序）。</p>
        @if (rules == null)
        {
            <p class="text-body-medium text-on-surface-variant flex items-center gap-2"><span class="md-circular-progress"></span>加载中…</p>
        }
        else if (rules.Count == 0)
        {
            <p class="text-body-medium text-on-surface-variant">暂无规则</p>
        }
        else
        {
            <div class="overflow-x-auto -mx-4 sm:-mx-6">
                <table class="md-table responsive-cards">
                    <thead>
                        <tr>
                            <th class="text-left">类型</th>
                            <th class="text-left">条件</th>
                            <th class="text-left">动作</th>
                            <th class="text-right hide-mobile">优先级</th>
                            <th class="text-center">启用</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in PagedRules)
                        {
                            <tr>
                                <td data-label="类型">
                                    <span class="md-chip @TypeClass(r.Type)">@r.Type</span>
                                </td>
                                <td data-label="条件" class="font-mono text-body-small text-on-surface-variant wrap-cell"><span class="break-all">@r.Condition</span></td>
                                <td data-label="动作" class="text-on-surface wrap-cell"><span class="break-words">@r.Action</span></td>
                                <td data-label="优先级" class="text-right text-on-surface-variant tabular-nums hide-mobile">@r.Priority</td>
                                <td data-label="启用" class="text-center">
                                    @if (r.IsActive)
                                    {
                                        <span class="material-symbols-outlined text-success text-base" title="已启用">check_circle</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-outline-variant text-base" title="已停用">remove_circle</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="rule-card-list">
                @foreach (var r in PagedRules)
                {
                    <div class="rule-card">
                        <div class="rule-card__top">
                            <span class="md-chip @TypeClass(r.Type)" style="height:1.5rem;padding:0 0.5rem;font-size:var(--text-label-small);">@r.Type</span>
                            <span class="rule-card__condition">@r.Condition</span>
                        </div>
                        <div class="rule-card__bottom">
                            <span class="rule-card__action">@r.Action</span>
                            @if (r.IsActive)
                            {
                                <span class="material-symbols-outlined text-success" style="font-size:18px;">check_circle</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-outline-variant" style="font-size:18px;">remove_circle</span>
                            }
                        </div>
                    </div>
                }
            </div>
            <Paginator TotalCount="rules.Count" PageSize="PageSize" @bind-Page="rulesPage" />
        }
    </div>
</div>

@code {
    private List<JobDto>? jobs;
    private List<RuleDto>? rules;
    private string fromStep = "ResolveMerchant";
    private int? batchId;
    private int? reparseBatchId;
    private bool busy;
    private bool reparseBusy;
    private bool clearBusy;
    private bool showClearConfirm;
    private Toast? toastRef;
    private CancellationTokenSource? cts;
    private Task? pollTask;
    private int jobsPage = 1;
    private int rulesPage = 1;
    private const int PageSize = 20;
    private IEnumerable<JobDto> PagedJobs => jobs?.Skip((jobsPage - 1) * PageSize).Take(PageSize) ?? [];
    private IEnumerable<RuleDto> PagedRules => rules?.Skip((rulesPage - 1) * PageSize).Take(PageSize) ?? [];

    protected override void OnInitialized()
    {
        cts = new CancellationTokenSource();
        pollTask = PollLoopAsync(cts.Token);
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await LoadAllAsync();
                await InvokeAsync(StateHasChanged);
                await Task.Delay(3000, ct);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAllAsync()
    {
        try
        {
            jobs = await Http.GetFromJsonAsync<List<JobDto>>("api/jobs?take=50");
            rules = await Http.GetFromJsonAsync<List<RuleDto>>("api/cleaning-rules");
        }
        catch { /* 忽略瞬时错误，下轮重试 */ }
    }

    private async Task TriggerRebuildAsync()
    {
        busy = true;
        try
        {
            var url = $"api/bill/rebuild?from={fromStep}";
            if (batchId.HasValue) url += $"&batchId={batchId.Value}";
            var resp = await Http.PostAsync(url, null);
            if (resp.IsSuccessStatusCode)
            {
                ShowToast("重建任务已入队，Worker 将异步执行", false);
                await LoadAllAsync();
            }
            else
            {
                ShowToast($"入队失败：{(int)resp.StatusCode}", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"入队异常：{ex.Message}", true);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task TriggerReParseAsync()
    {
        reparseBusy = true;
        try
        {
            var url = "api/bill/reparse";
            if (reparseBatchId.HasValue) url += $"?batchId={reparseBatchId.Value}";
            var resp = await Http.PostAsync(url, null);
            if (resp.IsSuccessStatusCode)
            {
                ShowToast("重解析任务已入队，Worker 将异步执行", false);
                await LoadAllAsync();
            }
            else
            {
                ShowToast($"入队失败：{(int)resp.StatusCode}", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"入队异常：{ex.Message}", true);
        }
        finally
        {
            reparseBusy = false;
        }
    }

    private void OnClearAllClick()
    {
        showClearConfirm = true;
    }

    private async Task ConfirmClearAllAsync()
    {
        showClearConfirm = false;
        clearBusy = true;
        try
        {
            var resp = await Http.PostAsync("api/bill/clear-all", null);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<ClearDataResult>();
                ShowToast($"数据已清空，共删除 {result?.TotalDeleted ?? 0} 条记录", false);
                await LoadAllAsync();
            }
            else
            {
                ShowToast($"清空失败：{(int)resp.StatusCode}", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"清空异常：{ex.Message}", true);
        }
        finally
        {
            clearBusy = false;
        }
    }

    private void ShowToast(string msg, bool isError)
    {
        _ = toastRef?.Show(msg, isError);
    }

    private static string StatusText(string s) => s switch
    {
        "Pending" => "等待中",
        "Running" => "执行中",
        "Completed" => "已完成",
        "Failed" => "失败",
        _ => s
    };

    private static string StatusClass(string s) => s switch
    {
        "Pending" => "md-chip-assist-info",
        "Running" => "md-chip-assist-primary",
        "Completed" => "md-chip-assist-success",
        "Failed" => "md-chip-assist-error",
        _ => "md-chip-assist-info"
    };

    private static string TypeClass(string t) => t switch
    {
        "Category" => "md-chip-assist-primary",
        "Merchant" => "md-chip-assist-warning",
        "Tag" => "md-chip-assist-info",
        _ => "md-chip-assist-info"
    };

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }

    private record JobDto(int Id, string Type, string Payload, string Status,
        DateTime CreatedAt, DateTime? StartedAt, DateTime? CompletedAt, string? Error);

    private record RuleDto(string Type, int RuleId, string Condition, string Action, int Priority, bool IsActive);

    private record ClearDataResult(int TotalDeleted, int BatchesDeleted, int RawRecordsDeleted,
        int NormalizedDeleted, int CanonicalDeleted, int DuplicatesDeleted, int PipelineRunsDeleted);
}
