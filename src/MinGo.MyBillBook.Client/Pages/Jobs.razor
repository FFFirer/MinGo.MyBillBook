@page "/jobs"
@using System.Net.Http.Json
@inject HttpClient Http
@implements IDisposable

<PageTitle>任务与重建</PageTitle>
<div class="space-y-4 sm:space-y-6">
    <div class="page-header">
        <h1>任务与重建</h1>
        <div class="actions">
            <button @onclick="LoadAllAsync" class="md-btn-filled state-layer">
                <span class="material-symbols-outlined mr-1">refresh</span>刷新
            </button>
        </div>
    </div>

    @if (toast != null)
    {
        <div class="md-snackbar @(toastIsError ? "md-snackbar-error" : "md-snackbar-success")" role="status" aria-live="polite">
            @toast
        </div>
    }

    <!-- 触发局部重建 -->
    <div class="md-card-elevated">
        <h2 class="text-title-medium md:text-title-large mb-1">局部重建</h2>
        <p class="text-body-small text-on-surface-variant mb-4">规则变更后从指定步骤起重算 Canonical 层，无需重导 CSV。请求入队后立即返回，由后台 Worker 异步执行。</p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-end gap-3">
            <div class="flex-1 sm:flex-none sm:min-w-[16rem]">
                <label for="fromStepSelect" class="block text-body-small text-on-surface-variant mb-1">起点步骤</label>
                <select id="fromStepSelect" @bind="fromStep" class="md-text-field-outlined w-full">
                    <option value="Normalize">Normalize（全量重建）</option>
                    <option value="ResolveMerchant">ResolveMerchant（商户重算）</option>
                    <option value="ClassifyCategory">ClassifyCategory（分类/标签重算）</option>
                </select>
            </div>
            <div class="flex-1 sm:flex-none sm:w-40">
                <label for="batchIdInput" class="block text-body-small text-on-surface-variant mb-1">批次 Id（留空=全部）</label>
                <input id="batchIdInput" type="number" @bind="batchId" placeholder="全部批次"
                       class="md-text-field-outlined w-full" />
            </div>
            <button @onclick="TriggerRebuildAsync" disabled="@busy"
                    class="md-btn-filled state-layer w-full sm:w-auto shrink-0">
                <span class="material-symbols-outlined mr-1">build</span>
                @(busy ? "入队中…" : "入队重建")
            </button>
        </div>
    </div>

    <!-- 任务队列 -->
    <div class="md-card-elevated">
        <h2 class="text-title-medium md:text-title-large mb-4">后台任务</h2>
        @if (jobs == null)
        {
            <p class="text-body-medium text-on-surface-variant flex items-center gap-2"><span class="md-circular-progress"></span>加载中…</p>
        }
        else if (jobs.Count == 0)
        {
            <p class="text-body-medium text-on-surface-variant">暂无任务</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-body-medium responsive-cards">
                    <thead>
                        <tr class="border-b border-outline-variant">
                            <th class="text-left py-2 px-2 text-label-large text-on-surface-variant">Id</th>
                            <th class="text-left py-2 px-2 text-label-large text-on-surface-variant">类型</th>
                            <th class="text-left py-2 px-2 text-label-large text-on-surface-variant hide-mobile">参数</th>
                            <th class="text-left py-2 px-2 text-label-large text-on-surface-variant">状态</th>
                            <th class="text-left py-2 px-2 text-label-large text-on-surface-variant hide-mobile">创建</th>
                            <th class="text-left py-2 px-2 text-label-large text-on-surface-variant hide-mobile">完成</th>
                            <th class="text-left py-2 px-2 text-label-large text-on-surface-variant hide-mobile">错误</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var j in jobs)
                        {
                            <tr class="border-b border-outline-variant hover:bg-surface-container">
                                <td data-label="Id" class="py-2 px-2 tabular-nums text-on-surface">@j.Id</td>
                                <td data-label="类型" class="py-2 px-2 text-on-surface">@j.Type</td>
                                <td data-label="参数" class="py-2 px-2 text-on-surface-variant font-mono text-body-small wrap-cell hide-mobile"><span class="break-all">@j.Payload</span></td>
                                <td data-label="状态" class="py-2 px-2">
                                    <span class="md-chip @StatusClass(j.Status)">@StatusText(j.Status)</span>
                                </td>
                                <td data-label="创建" class="py-2 px-2 text-on-surface-variant hide-mobile">@j.CreatedAt.ToString("MM-dd HH:mm:ss")</td>
                                <td data-label="完成" class="py-2 px-2 text-on-surface-variant hide-mobile">@(j.CompletedAt?.ToString("MM-dd HH:mm:ss") ?? "-")</td>
                                <td data-label="错误" class="py-2 px-2 text-error text-body-small max-w-xs wrap-cell hide-mobile"><span class="break-words" title="@j.Error">@(j.Error ?? "")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- 统一清洗规则视图 -->
    <div class="md-card-elevated">
        <h2 class="text-title-medium md:text-title-large mb-1">统一清洗规则</h2>
        <p class="text-body-small text-on-surface-variant mb-4">Category / Merchant / Tag 规则收敛视图（按优先级降序）。</p>
        @if (rules == null)
        {
            <p class="text-body-medium text-on-surface-variant flex items-center gap-2"><span class="md-circular-progress"></span>加载中…</p>
        }
        else if (rules.Count == 0)
        {
            <p class="text-body-medium text-on-surface-variant">暂无规则</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-body-medium responsive-cards">
                    <thead>
                        <tr class="border-b border-outline-variant">
                            <th class="text-left py-2 px-2 text-label-large text-on-surface-variant">类型</th>
                            <th class="text-left py-2 px-2 text-label-large text-on-surface-variant">条件</th>
                            <th class="text-left py-2 px-2 text-label-large text-on-surface-variant">动作</th>
                            <th class="text-right py-2 px-2 text-label-large text-on-surface-variant hide-mobile">优先级</th>
                            <th class="text-center py-2 px-2 text-label-large text-on-surface-variant">启用</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rules)
                        {
                            <tr class="border-b border-outline-variant hover:bg-surface-container">
                                <td data-label="类型" class="py-2 px-2">
                                    <span class="md-chip @TypeClass(r.Type)">@r.Type</span>
                                </td>
                                <td data-label="条件" class="py-2 px-2 font-mono text-body-small text-on-surface-variant wrap-cell"><span class="break-all">@r.Condition</span></td>
                                <td data-label="动作" class="py-2 px-2 text-on-surface wrap-cell"><span class="break-words">@r.Action</span></td>
                                <td data-label="优先级" class="py-2 px-2 text-right text-on-surface-variant tabular-nums hide-mobile">@r.Priority</td>
                                <td data-label="启用" class="py-2 px-2 text-center">
                                    @if (r.IsActive)
                                    {
                                        <span class="material-symbols-outlined text-success text-base" title="已启用">check_circle</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-outline-variant text-base" title="已停用">remove_circle</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<JobDto>? jobs;
    private List<RuleDto>? rules;
    private string fromStep = "ResolveMerchant";
    private int? batchId;
    private bool busy;
    private string? toast;
    private bool toastIsError;
    private CancellationTokenSource? cts;
    private Task? pollTask;

    protected override void OnInitialized()
    {
        cts = new CancellationTokenSource();
        pollTask = PollLoopAsync(cts.Token);
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await LoadAllAsync();
                await InvokeAsync(StateHasChanged);
                await Task.Delay(3000, ct);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadAllAsync()
    {
        try
        {
            jobs = await Http.GetFromJsonAsync<List<JobDto>>("api/jobs?take=50");
            rules = await Http.GetFromJsonAsync<List<RuleDto>>("api/cleaning-rules");
        }
        catch { /* 忽略瞬时错误，下轮重试 */ }
    }

    private async Task TriggerRebuildAsync()
    {
        busy = true;
        try
        {
            var url = $"api/bill/rebuild?from={fromStep}";
            if (batchId.HasValue) url += $"&batchId={batchId.Value}";
            var resp = await Http.PostAsync(url, null);
            if (resp.IsSuccessStatusCode)
            {
                ShowToast("重建任务已入队，Worker 将异步执行", false);
                await LoadAllAsync();
            }
            else
            {
                ShowToast($"入队失败：{(int)resp.StatusCode}", true);
            }
        }
        catch (Exception ex)
        {
            ShowToast($"入队异常：{ex.Message}", true);
        }
        finally
        {
            busy = false;
        }
    }

    private void ShowToast(string msg, bool isError)
    {
        toast = msg;
        toastIsError = isError;
        StateHasChanged();
        _ = Task.Delay(3000).ContinueWith(_ => { toast = null; InvokeAsync(StateHasChanged); });
    }

    private static string StatusText(string s) => s switch
    {
        "Pending" => "等待中",
        "Running" => "执行中",
        "Completed" => "已完成",
        "Failed" => "失败",
        _ => s
    };

    private static string StatusClass(string s) => s switch
    {
        "Pending" => "md-chip-assist-info",
        "Running" => "md-chip-assist-primary",
        "Completed" => "md-chip-assist-success",
        "Failed" => "md-chip-assist-error",
        _ => "md-chip-assist-info"
    };

    private static string TypeClass(string t) => t switch
    {
        "Category" => "md-chip-assist-primary",
        "Merchant" => "md-chip-assist-warning",
        "Tag" => "md-chip-assist-info",
        _ => "md-chip-assist-info"
    };

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }

    private record JobDto(int Id, string Type, string Payload, string Status,
        DateTime CreatedAt, DateTime? StartedAt, DateTime? CompletedAt, string? Error);

    private record RuleDto(string Type, int RuleId, string Condition, string Action, int Priority, bool IsActive);
}
