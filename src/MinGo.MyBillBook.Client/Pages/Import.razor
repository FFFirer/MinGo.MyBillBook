@page "/import"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>导入对账单</PageTitle>

<div class="space-y-4 sm:space-y-6">
    <div class="page-header">
        <h1>导入对账单</h1>
    </div>

    @if (importResult != null)
    {
        <div class="md-card-elevated p-4 sm:p-6">
            <h2 class="text-title-large mb-3 text-on-surface">导入结果</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
                <div class="text-center p-3 rounded-md bg-surface-container">
                    <p class="text-body-small text-on-surface-variant">总记录数</p>
                    <p class="text-title-large font-medium tabular-nums text-on-surface">@importResult.TotalCount</p>
                </div>
                <div class="text-center p-3 rounded-md bg-success-container">
                    <p class="text-body-small text-on-success-container">成功导入</p>
                    <p class="text-title-large font-medium text-on-success-container tabular-nums">@importResult.SuccessCount</p>
                </div>
                <div class="text-center p-3 rounded-md bg-warning-container">
                    <p class="text-body-small text-on-warning-container">重复跳过</p>
                    <p class="text-title-large font-medium text-on-warning-container tabular-nums">@importResult.DuplicateCount</p>
                </div>
                <div class="text-center p-3 rounded-md bg-primary-container">
                    <p class="text-body-small text-on-primary-container">批次 ID</p>
                    <p class="text-title-large font-medium text-on-primary-container tabular-nums">@importResult.BatchId</p>
                </div>
            </div>
            @if (importResult.Errors.Count > 0)
            {
                <div class="mt-3 p-3 rounded-md bg-error-container">
                    <p class="text-body-medium font-medium text-on-error-container">解析错误:</p>
                    @foreach (var err in importResult.Errors.Take(5))
                    {
                        <p class="text-body-small text-on-error-container break-words">@err</p>
                    }
                </div>
            }
            <div class="mt-4 flex flex-col sm:flex-row gap-2 sm:gap-3">
                <button @onclick="() => ProcessBatch(importResult.BatchId)" class="md-btn-filled flex-1">
                    <span class="material-symbols-outlined">play_arrow</span><span>立即处理此批次</span>
                </button>
                <button @onclick="ProcessAll" class="md-btn-outlined flex-1">
                    <span class="material-symbols-outlined">playlist_play</span><span>处理所有未处理</span>
                </button>
            </div>
        </div>
    }

    <div class="md-card-elevated p-4 sm:p-6">
        <h2 class="text-title-large mb-4 text-on-surface">上传文件</h2>

        <div class="space-y-4">
            <div>
                <label for="platformSelect" class="block text-label-large text-on-surface-variant mb-1">支付平台</label>
                <select id="platformSelect" @bind="platformId" class="md-text-field-outlined sm:max-w-xs">
                    <option value="1">支付宝</option>
                    <option value="2">微信支付</option>
                </select>
            </div>

            <div class="border-2 border-dashed border-outline rounded-md p-6 sm:p-8 text-center hover:border-primary focus-within:border-primary transition-colors">
                <InputFile OnChange="OnFileSelected" accept=".csv,.xls,.xlsx" class="hidden" id="fileInput" />
                <label for="fileInput" class="cursor-pointer block" role="button" tabindex="0"
                       onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();document.getElementById('fileInput').click();}">
                    <span class="material-symbols-outlined text-on-surface-variant block mb-2" style="font-size:2.5rem;">cloud_upload</span>
                    <p class="text-on-surface text-body-large">点击或拖拽账单文件到此处</p>
                    <p class="text-body-small text-on-surface-variant mt-1">支持支付宝、微信对账单 CSV / Excel 文件</p>
                </label>
            </div>

            @if (selectedFile != null)
            {
                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 p-3 rounded-md bg-primary-container">
                    <div class="flex items-center gap-2 min-w-0 flex-1">
                        <span class="material-symbols-outlined text-on-primary-container shrink-0">insert_drive_file</span>
                        <span class="text-body-medium text-on-primary-container truncate">@selectedFile.Name <span class="opacity-70">(@(selectedFile.Size / 1024) KB)</span></span>
                    </div>
                    <button @onclick="UploadFile" disabled="@isUploading" class="md-btn-filled sm:ml-auto w-full sm:w-auto shrink-0">
                        @if (isUploading)
                        {
                            <span class="loading-spinner mr-1" style="width:16px;height:16px;border-width:2px;"></span>
                        }
                        <span>@(isUploading ? "上传中…" : "开始导入")</span>
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="p-3 rounded-md bg-error-container text-body-medium text-on-error-container break-words" role="alert">@errorMessage</div>
            }
        </div>
    </div>

    @if (batches.Count > 0)
    {
        <div class="md-card-elevated p-4 sm:p-6">
            <h2 class="text-title-large mb-4 text-on-surface">导入历史</h2>
            <div class="overflow-x-auto -mx-4 sm:-mx-6">
                <table class="md-table responsive-cards">
                    <thead>
                        <tr>
                            <th class="text-left">平台</th>
                            <th class="text-left">文件名</th>
                            <th class="text-left hide-mobile">导入时间</th>
                            <th class="text-right">总数</th>
                            <th class="text-right hide-mobile">成功</th>
                            <th class="text-right hide-mobile">重复</th>
                            <th class="text-center">状态</th>
                            <th class="text-center">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in PagedBatches)
                        {
                            <tr>
                                <td data-label="平台">@batch.PlatformName</td>
                                <td data-label="文件名" class="text-on-surface-variant wrap-cell"><span class="break-all">@batch.FileName</span></td>
                                <td data-label="导入时间" class="text-on-surface-variant hide-mobile">@batch.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td data-label="总数" class="text-right tabular-nums">@batch.TotalCount</td>
                                <td data-label="成功" class="text-right text-success tabular-nums hide-mobile">@batch.SuccessCount</td>
                                <td data-label="重复" class="text-right text-warning tabular-nums hide-mobile">@batch.DuplicateCount</td>
                                <td data-label="状态" class="text-center">
                                    <span class="md-chip-assist @(batch.Status == "Completed" ? "md-chip-assist-success" : "md-chip-assist-warning")">
                                        @batch.Status
                                    </span>
                                </td>
                                <td data-label="操作" class="text-center">
                                    <div class="inline-flex items-center justify-center gap-2">
                                        @if (batch.Status == "Imported")
                                        {
                                            <button @onclick="() => ProcessBatch(batch.Id)" class="md-btn-text">处理</button>
                                        }
                                        <button @onclick="() => TogglePipeline(batch.Id)" class="md-btn-text">进度</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Paginator TotalCount="batches.Count" PageSize="PageSize" @bind-Page="batchesPage" />

            @if (pipelineBatchId.HasValue && pipelineRuns.Count > 0)
            {
                <div class="mt-5 border-t border-outline-variant pt-4">
                    <h3 class="text-title-small text-on-surface mb-3">批次 #@pipelineBatchId 管道执行记录</h3>
                    @foreach (var run in pipelineRuns)
                    {
                        <div class="mb-4 p-3 rounded-md bg-surface-container">
                            <div class="flex flex-wrap items-center gap-2 text-body-small text-on-surface-variant mb-2">
                                <span class="md-chip-assist @(run.Status == "Completed" ? "md-chip-assist-success" : run.Status == "Failed" ? "md-chip-assist-error" : "md-chip-assist-warning")">@run.Status</span>
                                <span>@run.PipelineType</span>
                                <span class="break-all">@run.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            </div>
                            <div class="space-y-1.5">
                                @foreach (var step in run.Steps)
                                {
                                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-body-medium">
                                        <span class="material-symbols-outlined shrink-0 @(step.Status == "Completed" ? "text-success" : step.Status == "Failed" ? "text-error" : "text-warning")" style="font-size:1.125rem;">
                                            @(step.Status == "Completed" ? "check_circle" : step.Status == "Failed" ? "error" : "pending")
                                        </span>
                                        <span class="w-full sm:w-40 text-on-surface truncate" title="@step.StepName">@step.StepName</span>
                                        <span class="text-on-surface-variant text-body-small tabular-nums">输入 @step.InputCount / 输出 @step.OutputCount</span>
                                        @if (step.ErrorCount > 0)
                                        {
                                            <span class="text-error text-body-small">错误 @step.ErrorCount</span>
                                        }
                                        @if (step.WarningCount > 0)
                                        {
                                            <span class="text-warning text-body-small">告警 @step.WarningCount</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private int platformId = 1;
    private IBrowserFile? selectedFile;
    private bool isUploading;
    private string? errorMessage;
    private BillImportResult? importResult;
    private List<BatchInfo> batches = [];
    private int? pipelineBatchId;
    private List<PipelineRunInfo> pipelineRuns = [];
    private int batchesPage = 1;
    private const int PageSize = 20;
    private IEnumerable<BatchInfo> PagedBatches => batches.Skip((batchesPage - 1) * PageSize).Take(PageSize);

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = null;
        importResult = null;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null) return;
        isUploading = true;
        errorMessage = null;

        try
        {
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/octet-stream");
            content.Add(streamContent, "file", selectedFile.Name);
            content.Add(new StringContent(platformId.ToString()), "platformId");

            var response = await Http.PostAsync("api/bill/import", content);
            if (response.IsSuccessStatusCode)
            {
                importResult = await response.Content.ReadFromJsonAsync<BillImportResult>();
                await LoadBatches();
            }
            else
            {
                errorMessage = $"导入失败: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"导入出错: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task ProcessBatch(int batchId)
    {
        try
        {
            var response = await Http.PostAsync($"api/bill/import/batches/{batchId}/process", null);
            if (response.IsSuccessStatusCode)
                await LoadBatches();
        }
        catch { }
    }

    private async Task ProcessAll()
    {
        try
        {
            var response = await Http.PostAsync("api/bill/import/process-all", null);
            if (response.IsSuccessStatusCode)
                await LoadBatches();
        }
        catch { }
    }

    private async Task LoadBatches()
    {
        try
        {
            batches = await Http.GetFromJsonAsync<List<BatchInfo>>("api/bill/import/batches") ?? [];
        }
        catch { }
    }

    private async Task TogglePipeline(int batchId)
    {
        if (pipelineBatchId == batchId)
        {
            pipelineBatchId = null;
            pipelineRuns = [];
            return;
        }
        pipelineBatchId = batchId;
        try
        {
            pipelineRuns = await Http.GetFromJsonAsync<List<PipelineRunInfo>>($"api/bill/import/batches/{batchId}/pipeline") ?? [];
        }
        catch { pipelineRuns = []; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBatches();
    }

    private record BillImportResult(int BatchId, string FileName, int TotalCount, int SuccessCount, int DuplicateCount, List<string> Errors);
    private record BatchInfo(int Id, string PlatformName, string FileName, DateTime ImportDate, int TotalCount, int SuccessCount, int DuplicateCount, string Status);
    private record PipelineRunInfo(int Id, string PipelineType, string Status, DateTime StartedAt, DateTime? CompletedAt, List<PipelineStepInfo> Steps);
    private record PipelineStepInfo(string StepName, string Status, int InputCount, int OutputCount, int ErrorCount, int WarningCount, DateTime? CompletedAt);
}
