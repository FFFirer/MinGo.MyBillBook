@page "/import"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>导入对账单</PageTitle>

<div class="space-y-4 sm:space-y-6">
    <div class="page-header">
        <h1>导入对账单</h1>
    </div>

    @if (importResult != null)
    {
        <div class="bg-white rounded-xl shadow-sm p-4 sm:p-6 border border-gray-100">
            <h2 class="text-base sm:text-lg font-semibold mb-3">导入结果</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
                <div class="text-center p-2 rounded-lg bg-gray-50">
                    <p class="text-xs sm:text-sm text-gray-500">总记录数</p>
                    <p class="text-lg sm:text-xl font-bold tabular-nums">@importResult.TotalCount</p>
                </div>
                <div class="text-center p-2 rounded-lg bg-green-50">
                    <p class="text-xs sm:text-sm text-gray-500">成功导入</p>
                    <p class="text-lg sm:text-xl font-bold text-green-600 tabular-nums">@importResult.SuccessCount</p>
                </div>
                <div class="text-center p-2 rounded-lg bg-yellow-50">
                    <p class="text-xs sm:text-sm text-gray-500">重复跳过</p>
                    <p class="text-lg sm:text-xl font-bold text-yellow-600 tabular-nums">@importResult.DuplicateCount</p>
                </div>
                <div class="text-center p-2 rounded-lg bg-purple-50">
                    <p class="text-xs sm:text-sm text-gray-500">批次 ID</p>
                    <p class="text-lg sm:text-xl font-bold text-purple-600 tabular-nums">@importResult.BatchId</p>
                </div>
            </div>
            @if (importResult.Errors.Count > 0)
            {
                <div class="mt-3 p-3 bg-red-50 rounded-lg">
                    <p class="text-sm font-medium text-red-700">解析错误:</p>
                    @foreach (var err in importResult.Errors.Take(5))
                    {
                        <p class="text-xs text-red-600 break-words">@err</p>
                    }
                </div>
            }
            <div class="mt-4 flex flex-col sm:flex-row gap-2 sm:gap-3">
                <button @onclick="() => ProcessBatch(importResult.BatchId)" class="flex-1 inline-flex items-center justify-center px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 active:bg-purple-800 min-h-[44px] transition-colors">
                    <span class="material-icons text-base mr-1">play_arrow</span>立即处理此批次
                </button>
                <button @onclick="ProcessAll" class="flex-1 inline-flex items-center justify-center px-4 py-2 bg-white text-purple-600 border border-purple-200 rounded-lg hover:bg-purple-50 active:bg-purple-100 min-h-[44px] transition-colors">
                    <span class="material-icons text-base mr-1">playlist_play</span>处理所有未处理
                </button>
            </div>
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm p-4 sm:p-6 border border-gray-100">
        <h2 class="text-base sm:text-lg font-semibold mb-4">上传文件</h2>

        <div class="space-y-4">
            <div>
                <label for="platformSelect" class="block text-sm font-medium text-gray-700 mb-1">支付平台</label>
                <select id="platformSelect" @bind="platformId" class="w-full sm:max-w-xs rounded-lg border-gray-300 shadow-sm px-3 py-2 border focus:border-purple-500 focus:ring-purple-500 min-h-[44px]">
                    <option value="1">支付宝</option>
                    <option value="2">微信支付</option>
                </select>
            </div>

            <div class="border-2 border-dashed border-gray-300 rounded-xl p-6 sm:p-8 text-center hover:border-purple-400 focus-within:border-purple-500 transition-colors">
                <InputFile OnChange="OnFileSelected" accept=".csv,.xls,.xlsx" class="hidden" id="fileInput" />
                <label for="fileInput" class="cursor-pointer block" role="button" tabindex="0"
                       onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();document.getElementById('fileInput').click();}">
                    <span class="material-icons text-4xl text-gray-400 block mb-2">cloud_upload</span>
                    <p class="text-gray-600 text-sm sm:text-base">点击或拖拽账单文件到此处</p>
                    <p class="text-xs sm:text-sm text-gray-400 mt-1">支持支付宝、微信对账单 CSV / Excel 文件</p>
                </label>
            </div>

            @if (selectedFile != null)
            {
                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 p-3 bg-purple-50 rounded-lg">
                    <div class="flex items-center gap-2 min-w-0 flex-1">
                        <span class="material-icons text-purple-600 shrink-0">insert_drive_file</span>
                        <span class="text-sm text-gray-700 truncate">@selectedFile.Name <span class="text-gray-400">(@(selectedFile.Size / 1024) KB)</span></span>
                    </div>
                    <button @onclick="UploadFile" disabled="@isUploading"
                            class="sm:ml-auto w-full sm:w-auto inline-flex items-center justify-center px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 active:bg-purple-800 disabled:opacity-50 min-h-[44px] transition-colors shrink-0">
                        @if (isUploading)
                        {
                            <span class="loading-spinner mr-2" style="width:16px;height:16px;border-width:2px;"></span>
                        }
                        @(isUploading ? "上传中…" : "开始导入")
                    </button>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="p-3 bg-red-50 rounded-lg text-sm text-red-700 break-words" role="alert">@errorMessage</div>
            }
        </div>
    </div>

    @if (batches.Count > 0)
    {
        <div class="bg-white rounded-xl shadow-sm p-4 sm:p-6 border border-gray-100">
            <h2 class="text-base sm:text-lg font-semibold mb-4">导入历史</h2>
            <div class="overflow-x-auto">
                <table class="w-full text-sm responsive-cards">
                    <thead>
                        <tr class="border-b border-gray-200">
                            <th class="text-left py-2 px-3 font-medium text-gray-500">平台</th>
                            <th class="text-left py-2 px-3 font-medium text-gray-500">文件名</th>
                            <th class="text-left py-2 px-3 font-medium text-gray-500 hide-mobile">导入时间</th>
                            <th class="text-right py-2 px-3 font-medium text-gray-500">总数</th>
                            <th class="text-right py-2 px-3 font-medium text-gray-500 hide-mobile">成功</th>
                            <th class="text-right py-2 px-3 font-medium text-gray-500 hide-mobile">重复</th>
                            <th class="text-center py-2 px-3 font-medium text-gray-500">状态</th>
                            <th class="text-center py-2 px-3 font-medium text-gray-500">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var batch in batches)
                        {
                            <tr class="border-b border-gray-100 hover:bg-gray-50">
                                <td data-label="平台" class="py-2 px-3">@batch.PlatformName</td>
                                <td data-label="文件名" class="py-2 px-3 text-gray-600 wrap-cell"><span class="break-all">@batch.FileName</span></td>
                                <td data-label="导入时间" class="py-2 px-3 text-gray-500 hide-mobile">@batch.ImportDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td data-label="总数" class="py-2 px-3 text-right tabular-nums">@batch.TotalCount</td>
                                <td data-label="成功" class="py-2 px-3 text-right text-green-600 tabular-nums hide-mobile">@batch.SuccessCount</td>
                                <td data-label="重复" class="py-2 px-3 text-right text-yellow-600 tabular-nums hide-mobile">@batch.DuplicateCount</td>
                                <td data-label="状态" class="py-2 px-3 text-center">
                                    <span class="px-2 py-1 rounded-full text-xs @(batch.Status == "Completed" ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700")">
                                        @batch.Status
                                    </span>
                                </td>
                                <td data-label="操作" class="py-2 px-3 text-center">
                                    <div class="inline-flex items-center justify-center gap-2">
                                        @if (batch.Status == "Imported")
                                        {
                                            <button @onclick="() => ProcessBatch(batch.Id)" class="px-3 py-1.5 text-purple-600 hover:text-purple-800 hover:bg-purple-50 rounded-lg text-xs font-medium min-h-[36px] inline-flex items-center transition-colors">处理</button>
                                        }
                                        <button @onclick="() => TogglePipeline(batch.Id)" class="px-3 py-1.5 text-gray-500 hover:text-purple-700 hover:bg-gray-100 rounded-lg text-xs font-medium min-h-[36px] inline-flex items-center transition-colors">进度</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (pipelineBatchId.HasValue && pipelineRuns.Count > 0)
            {
                <div class="mt-5 border-t border-gray-100 pt-4">
                    <h3 class="text-sm font-semibold text-gray-700 mb-3">批次 #@pipelineBatchId 管道执行记录</h3>
                    @foreach (var run in pipelineRuns)
                    {
                        <div class="mb-4 p-3 bg-gray-50 rounded-lg">
                            <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500 mb-2">
                                <span class="px-2 py-0.5 rounded-full @(run.Status == "Completed" ? "bg-green-100 text-green-700" : run.Status == "Failed" ? "bg-red-100 text-red-700" : "bg-yellow-100 text-yellow-700")">@run.Status</span>
                                <span>@run.PipelineType</span>
                                <span class="break-all">@run.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
                            </div>
                            <div class="space-y-1.5">
                                @foreach (var step in run.Steps)
                                {
                                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                                        <span class="material-icons text-base shrink-0 @(step.Status == "Completed" ? "text-green-500" : step.Status == "Failed" ? "text-red-500" : "text-yellow-500")">
                                            @(step.Status == "Completed" ? "check_circle" : step.Status == "Failed" ? "error" : "pending")
                                        </span>
                                        <span class="w-full sm:w-40 text-gray-700 truncate" title="@step.StepName">@step.StepName</span>
                                        <span class="text-gray-400 text-xs tabular-nums">输入 @step.InputCount / 输出 @step.OutputCount</span>
                                        @if (step.ErrorCount > 0)
                                        {
                                            <span class="text-red-500 text-xs">错误 @step.ErrorCount</span>
                                        }
                                        @if (step.WarningCount > 0)
                                        {
                                            <span class="text-yellow-600 text-xs">告警 @step.WarningCount</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private int platformId = 1;
    private IBrowserFile? selectedFile;
    private bool isUploading;
    private string? errorMessage;
    private BillImportResult? importResult;
    private List<BatchInfo> batches = [];
    private int? pipelineBatchId;
    private List<PipelineRunInfo> pipelineRuns = [];

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = null;
        importResult = null;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null) return;
        isUploading = true;
        errorMessage = null;

        try
        {
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var content = new MultipartFormDataContent();
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/octet-stream");
            content.Add(streamContent, "file", selectedFile.Name);
            content.Add(new StringContent(platformId.ToString()), "platformId");

            var response = await Http.PostAsync("api/bill/import", content);
            if (response.IsSuccessStatusCode)
            {
                importResult = await response.Content.ReadFromJsonAsync<BillImportResult>();
                await LoadBatches();
            }
            else
            {
                errorMessage = $"导入失败: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"导入出错: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task ProcessBatch(int batchId)
    {
        try
        {
            var response = await Http.PostAsync($"api/bill/import/batches/{batchId}/process", null);
            if (response.IsSuccessStatusCode)
                await LoadBatches();
        }
        catch { }
    }

    private async Task ProcessAll()
    {
        try
        {
            var response = await Http.PostAsync("api/bill/import/process-all", null);
            if (response.IsSuccessStatusCode)
                await LoadBatches();
        }
        catch { }
    }

    private async Task LoadBatches()
    {
        try
        {
            batches = await Http.GetFromJsonAsync<List<BatchInfo>>("api/bill/import/batches") ?? [];
        }
        catch { }
    }

    private async Task TogglePipeline(int batchId)
    {
        if (pipelineBatchId == batchId)
        {
            pipelineBatchId = null;
            pipelineRuns = [];
            return;
        }
        pipelineBatchId = batchId;
        try
        {
            pipelineRuns = await Http.GetFromJsonAsync<List<PipelineRunInfo>>($"api/bill/import/batches/{batchId}/pipeline") ?? [];
        }
        catch { pipelineRuns = []; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadBatches();
    }

    private record BillImportResult(int BatchId, string FileName, int TotalCount, int SuccessCount, int DuplicateCount, List<string> Errors);
    private record BatchInfo(int Id, string PlatformName, string FileName, DateTime ImportDate, int TotalCount, int SuccessCount, int DuplicateCount, string Status);
    private record PipelineRunInfo(int Id, string PipelineType, string Status, DateTime StartedAt, DateTime? CompletedAt, List<PipelineStepInfo> Steps);
    private record PipelineStepInfo(string StepName, string Status, int InputCount, int OutputCount, int ErrorCount, int WarningCount, DateTime? CompletedAt);
}
