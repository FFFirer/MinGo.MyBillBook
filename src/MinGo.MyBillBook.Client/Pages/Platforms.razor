@page "/platforms"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>支付平台</PageTitle>
<div class="space-y-4 sm:space-y-6">
    <div class="page-header">
        <h1>支付平台</h1>
        <div class="actions">
            <button @onclick="OpenCreateDialog" class="md-btn-filled state-layer">
                <span class="material-symbols-outlined mr-1 sm:mr-2">add</span>
                <span class="hidden xs:inline">新增平台</span><span class="xs:hidden">新增</span>
            </button>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="bg-error-container text-on-error-container px-4 py-3 rounded-md flex justify-between items-start gap-3" role="alert">
            <span class="flex-1 text-body-medium break-words">@errorMessage</span>
            <button @onclick="() => errorMessage = null" class="md-icon-btn shrink-0" aria-label="关闭">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        @if (platforms != null)
        {
            @foreach (var p in platforms)
            {
                <div class="md-card-elevated card-hover">
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center min-w-0">
                            <div class="p-2 sm:p-3 rounded-full bg-secondary-container mr-3 sm:mr-4 shrink-0">
                                <span class="material-symbols-outlined text-on-secondary-container text-xl sm:text-2xl">payment</span>
                            </div>
                            <div class="min-w-0">
                                <h3 class="text-title-medium md:text-title-large text-on-surface truncate">@p.Name</h3>
                                <p class="text-body-small text-on-surface-variant truncate">代码: @p.Code · 账户数: @p.AccountCount</p>
                            </div>
                        </div>
                        <div class="flex gap-1 shrink-0">
                            <button @onclick="() => OpenEditDialog(p)" class="md-icon-btn" title="编辑" aria-label="编辑 @p.Name">
                                <span class="material-symbols-outlined">edit</span>
                            </button>
                            <button @onclick="() => DeletePlatform(p)" class="md-icon-btn" title="删除" aria-label="删除 @p.Name">
                                <span class="material-symbols-outlined text-error">delete</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- 删除确认弹窗 -->
@if (confirmDeleteName != null)
{
    <div class="modal-root" @onclick="CancelDelete" role="alertdialog" aria-modal="true" aria-label="确认删除">
        <div class="modal-panel modal-sm" @onclick:stopPropagation>
            <div class="flex items-center mb-4">
                <div class="p-2 rounded-full bg-error-container mr-3 shrink-0">
                    <span class="material-symbols-outlined text-error">warning</span>
                </div>
                <h2 class="text-title-large text-on-surface">确认删除</h2>
            </div>
            <p class="text-body-medium text-on-surface-variant mb-6">确定要删除平台「<strong class="text-on-surface">@confirmDeleteName</strong>」吗？此操作不可撤销。</p>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3">
                <button @onclick="CancelDelete" class="md-btn-outlined state-layer w-full sm:w-auto">取消</button>
                <button @onclick="ConfirmDelete" class="md-btn-danger state-layer w-full sm:w-auto">确认删除</button>
            </div>
        </div>
    </div>
}

<!-- 新增/编辑弹窗 -->
@if (showDialog)
{
    <div class="modal-root" @onclick="CloseDialog" role="dialog" aria-modal="true" aria-label="@(editingId.HasValue ? "编辑平台" : "新增平台")">
        <div class="modal-panel modal-sm" @onclick:stopPropagation>
            <h2 class="text-title-large text-on-surface mb-4">@(editingId.HasValue ? "编辑平台" : "新增平台")</h2>
            <div class="space-y-4">
                <div>
                    <label for="platNameInput" class="block text-body-small text-on-surface-variant mb-1">名称</label>
                    <input id="platNameInput" @bind="formName" class="md-text-field-outlined w-full" placeholder="如：支付宝" />
                </div>
                <div>
                    <label for="platCodeInput" class="block text-body-small text-on-surface-variant mb-1">代码</label>
                    <input id="platCodeInput" @bind="formCode" class="md-text-field-outlined w-full" placeholder="如：ALIPAY" />
                </div>
                <div>
                    <label for="platIconInput" class="block text-body-small text-on-surface-variant mb-1">图标 URL（可选）</label>
                    <input id="platIconInput" @bind="formIconUrl" class="md-text-field-outlined w-full" placeholder="/icons/xxx.svg" />
                </div>
            </div>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3 mt-6">
                <button @onclick="CloseDialog" class="md-btn-outlined state-layer w-full sm:w-auto">取消</button>
                <button @onclick="SavePlatform" disabled="@isSaving" class="md-btn-filled state-layer w-full sm:w-auto">
                    @(isSaving ? "保存中…" : "保存")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<PlatformDto>? platforms;
    private bool showDialog;
    private int? editingId;
    private int? confirmDeleteId;
    private string? confirmDeleteName;
    private string formName = string.Empty;
    private string formCode = string.Empty;
    private string? formIconUrl;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlatforms();
    }

    private async Task LoadPlatforms()
    {
        platforms = await Http.GetFromJsonAsync<List<PlatformDto>>("api/platforms");
    }

    private void OpenCreateDialog()
    {
        editingId = null;
        formName = string.Empty;
        formCode = string.Empty;
        formIconUrl = null;
        errorMessage = null;
        showDialog = true;
    }

    private void OpenEditDialog(PlatformDto p)
    {
        editingId = p.Id;
        formName = p.Name;
        formCode = p.Code;
        formIconUrl = p.IconUrl;
        errorMessage = null;
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingId = null;
    }

    private async Task SavePlatform()
    {
        if (string.IsNullOrWhiteSpace(formName) || string.IsNullOrWhiteSpace(formCode))
        {
            errorMessage = "名称和代码为必填项";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            var payload = new { Name = formName, Code = formCode, IconUrl = formIconUrl };

            if (editingId.HasValue)
            {
                var response = await Http.PutAsJsonAsync($"api/platforms/{editingId.Value}", payload);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "保存失败";
                    return;
                }
            }
            else
            {
                var response = await Http.PostAsJsonAsync("api/platforms", payload);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "创建失败";
                    return;
                }
            }

            CloseDialog();
            await LoadPlatforms();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeletePlatform(PlatformDto p)
    {
        if (p.AccountCount > 0)
        {
            errorMessage = $"无法删除「{p.Name}」：该平台下还有 {p.AccountCount} 个资金账户";
            return;
        }
        confirmDeleteId = p.Id;
        confirmDeleteName = p.Name;
    }

    private void CancelDelete()
    {
        confirmDeleteId = null;
        confirmDeleteName = null;
    }

    private async Task ConfirmDelete()
    {
        if (confirmDeleteId == null) return;
        var response = await Http.DeleteAsync($"api/platforms/{confirmDeleteId}");
        if (response.IsSuccessStatusCode)
        {
            await LoadPlatforms();
        }
        else
        {
            var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            errorMessage = error?.Message ?? "删除失败";
        }
        CancelDelete();
    }

    private record PlatformDto(int Id, string Name, string Code, string? IconUrl, int AccountCount);
    private record ErrorResponse(string Message);
}
