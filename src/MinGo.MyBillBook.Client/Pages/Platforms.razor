@page "/platforms"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>支付平台</PageTitle>
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-800">支付平台</h1>
        <button @onclick="OpenCreateDialog" class="inline-flex items-center px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors">
            <span class="material-icons mr-2">add</span>
            新增平台
        </button>
    </div>

    @if (errorMessage != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex justify-between items-center">
            <span>@errorMessage</span>
            <button @onclick="() => errorMessage = null" class="text-red-500 hover:text-red-700">
                <span class="material-icons text-lg">close</span>
            </button>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @if (platforms != null)
        {
            @foreach (var p in platforms)
            {
                <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100 card-hover">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="p-3 rounded-lg bg-purple-100 mr-4">
                                <span class="material-icons text-purple-600 text-2xl">payment</span>
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-gray-800">@p.Name</h3>
                                <p class="text-sm text-gray-500">代码: @p.Code | 账户数: @p.AccountCount</p>
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <button @onclick="() => OpenEditDialog(p)" class="p-2 text-gray-400 hover:text-purple-600 transition-colors" title="编辑">
                                <span class="material-icons text-lg">edit</span>
                            </button>
                            <button @onclick="() => DeletePlatform(p)" class="p-2 text-gray-400 hover:text-red-600 transition-colors" title="删除">
                                <span class="material-icons text-lg">delete</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- 删除确认弹窗 -->
@if (confirmDeleteName != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="CancelDelete">
        <div class="bg-white rounded-xl shadow-xl p-6 max-w-sm w-full mx-4" @onclick:stopPropagation>
            <div class="flex items-center mb-4">
                <div class="p-2 rounded-lg bg-red-100 mr-3">
                    <span class="material-icons text-red-600">warning</span>
                </div>
                <h2 class="text-lg font-semibold text-gray-800">确认删除</h2>
            </div>
            <p class="text-gray-600 mb-6">确定要删除平台「<strong>@confirmDeleteName</strong>」吗？此操作不可撤销。</p>
            <div class="flex justify-end gap-3">
                <button @onclick="CancelDelete" class="px-4 py-2 text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">取消</button>
                <button @onclick="ConfirmDelete" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">确认删除</button>
            </div>
        </div>
    </div>
}

<!-- 新增/编辑弹窗 -->
@if (showDialog)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="CloseDialog">
        <div class="bg-white rounded-xl shadow-xl p-6 max-w-md w-full mx-4" @onclick:stopPropagation>
            <h2 class="text-lg font-semibold text-gray-800 mb-4">@(editingId.HasValue ? "编辑平台" : "新增平台")</h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">名称</label>
                    <input @bind="formName" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="如：支付宝" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">代码</label>
                    <input @bind="formCode" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="如：ALIPAY" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">图标 URL（可选）</label>
                    <input @bind="formIconUrl" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="/icons/xxx.svg" />
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-6">
                <button @onclick="CloseDialog" class="px-4 py-2 text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">取消</button>
                <button @onclick="SavePlatform" disabled="@isSaving" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors disabled:opacity-50">
                    @(isSaving ? "保存中..." : "保存")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<PlatformDto>? platforms;
    private bool showDialog;
    private int? editingId;
    private int? confirmDeleteId;
    private string? confirmDeleteName;
    private string formName = string.Empty;
    private string formCode = string.Empty;
    private string? formIconUrl;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlatforms();
    }

    private async Task LoadPlatforms()
    {
        platforms = await Http.GetFromJsonAsync<List<PlatformDto>>("api/platforms");
    }

    private void OpenCreateDialog()
    {
        editingId = null;
        formName = string.Empty;
        formCode = string.Empty;
        formIconUrl = null;
        errorMessage = null;
        showDialog = true;
    }

    private void OpenEditDialog(PlatformDto p)
    {
        editingId = p.Id;
        formName = p.Name;
        formCode = p.Code;
        formIconUrl = p.IconUrl;
        errorMessage = null;
        showDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        editingId = null;
    }

    private async Task SavePlatform()
    {
        if (string.IsNullOrWhiteSpace(formName) || string.IsNullOrWhiteSpace(formCode))
        {
            errorMessage = "名称和代码为必填项";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            var payload = new { Name = formName, Code = formCode, IconUrl = formIconUrl };

            if (editingId.HasValue)
            {
                var response = await Http.PutAsJsonAsync($"api/platforms/{editingId.Value}", payload);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "保存失败";
                    return;
                }
            }
            else
            {
                var response = await Http.PostAsJsonAsync("api/platforms", payload);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "创建失败";
                    return;
                }
            }

            CloseDialog();
            await LoadPlatforms();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeletePlatform(PlatformDto p)
    {
        if (p.AccountCount > 0)
        {
            errorMessage = $"无法删除「{p.Name}」：该平台下还有 {p.AccountCount} 个资金账户";
            return;
        }
        confirmDeleteId = p.Id;
        confirmDeleteName = p.Name;
    }

    private void CancelDelete()
    {
        confirmDeleteId = null;
        confirmDeleteName = null;
    }

    private async Task ConfirmDelete()
    {
        if (confirmDeleteId == null) return;
        var response = await Http.DeleteAsync($"api/platforms/{confirmDeleteId}");
        if (response.IsSuccessStatusCode)
        {
            await LoadPlatforms();
        }
        else
        {
            var error = await response.Content.ReadFromJsonAsync<ErrorResponse>();
            errorMessage = error?.Message ?? "删除失败";
        }
        CancelDelete();
    }

    private record PlatformDto(int Id, string Name, string Code, string? IconUrl, int AccountCount);
    private record ErrorResponse(string Message);
}
