@page "/bills"
@using System.Net.Http.Json
@using System.Globalization
@using Microsoft.AspNetCore.Components
@inject HttpClient Http

<PageTitle>账单明细</PageTitle>

<div class="space-y-4 sm:space-y-6">
    <div class="page-header">
        <h1>账单明细</h1>
        <div class="actions">
            <a href="/api/export/bills" download class="md-btn-filled state-layer !bg-success !text-on-success">
                <span class="material-symbols-outlined mr-1">download</span><span class="hidden xs:inline">导出 CSV</span><span class="xs:hidden">导出</span>
            </a>
        </div>
    </div>

    <!-- 筛选面板：移动端可折叠 -->
    <div class="md-card-elevated overflow-hidden">
        <button type="button" class="filter-toggle" @onclick="ToggleFilters" aria-expanded="@(!filtersCollapsed)">
            <span class="inline-flex items-center gap-2">
                <span class="material-symbols-outlined">tune</span>
                筛选条件
                @if (ActiveFilterCount > 0)
                {
                    <span class="md-badge">@ActiveFilterCount</span>
                }
            </span>
            <span class="material-symbols-outlined transition-transform @(filtersCollapsed ? "" : "rotate-180")">expand_more</span>
        </button>
        <div class="filter-body @(filtersCollapsed ? "collapsed" : "") p-3 sm:p-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
                <label class="block">
                    <span class="block text-body-small text-on-surface-variant mb-1">开始日期</span>
                    <input type="date" @bind="filter.StartDate" class="md-text-field-outlined w-full" placeholder="开始日期" />
                </label>
                <label class="block">
                    <span class="block text-body-small text-on-surface-variant mb-1">结束日期</span>
                    <input type="date" @bind="filter.EndDate" class="md-text-field-outlined w-full" placeholder="结束日期" />
                </label>
                <label class="block">
                    <span class="block text-body-small text-on-surface-variant mb-1">支付平台</span>
                    <select @bind="filter.PlatformId" class="md-text-field-outlined w-full">
                        <option value="">全部平台</option>
                        <option value="1">支付宝</option>
                        <option value="2">微信支付</option>
                    </select>
                </label>
                <label class="block">
                    <span class="block text-body-small text-on-surface-variant mb-1">交易类型</span>
                    <select @bind="filter.TransactionType" class="md-text-field-outlined w-full">
                        <option value="">全部类型</option>
                        <option value="Income">收入</option>
                        <option value="Expense">支出</option>
                        <option value="Transfer">转账</option>
                    </select>
                </label>
                <label class="block">
                    <span class="block text-body-small text-on-surface-variant mb-1">标签</span>
                    <select @bind="filter.TagId" class="md-text-field-outlined w-full">
                        <option value="">全部标签</option>
                        @if (allTags != null)
                        {
                            @foreach (var t in allTags)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        }
                    </select>
                </label>
                <div class="flex gap-2 sm:col-span-2 lg:col-span-5">
                    <input type="search" @bind="filter.Keyword" @bind:event="oninput" placeholder="搜索关键词…"
                           class="md-text-field-outlined flex-1 min-w-0" />
                    <button @onclick="LoadBills" class="md-btn-filled state-layer shrink-0" aria-label="搜索">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 统计摘要 -->
    @if (result != null)
    {
        <div class="text-body-small text-on-surface-variant">
            共 @result.TotalCount 条记录，第 @result.Page / @((int)Math.Ceiling((double)result.TotalCount / result.PageSize)) 页
        </div>
    }

    <!-- 账单列表 -->
    <div class="md-card-elevated overflow-hidden">
        @if (result?.Items.Count > 0)
        {
            <div class="overflow-x-auto -mx-4 sm:-mx-6">
                <table class="md-table responsive-cards">
                    <thead>
                        <tr>
                            <th class="text-left">日期</th>
                            <th class="text-left">商户/对方</th>
                            <th class="text-left hide-mobile">商品</th>
                            <th class="text-left">分类</th>
                            <th class="text-left hide-mobile">标签</th>
                            <th class="text-right">金额</th>
                            <th class="text-center hide-mobile">平台</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bill in result.Items)
                        {
                            <tr class="cursor-pointer" @onclick="() => OpenDetail(bill)">
                                <td data-label="日期" class="text-on-surface-variant whitespace-nowrap">@bill.TransactionDate.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</td>
                                <td data-label="商户" class="wrap-cell">
                                    <div class="font-medium text-on-surface truncate max-w-48">@bill.Merchant</div>
                                    @if (bill.IsManualAdjusted)
                                    {
                                        <span class="text-body-small text-primary">已修正</span>
                                    }
                                </td>
                                <td data-label="商品" class="text-on-surface-variant truncate max-w-48 wrap-cell hide-mobile">@bill.ProductName</td>
                                <td data-label="分类">
                                    <span class="md-chip md-chip-assist-info">
                                        @(bill.CategoryName ?? "未分类")
                                    </span>
                                </td>
                                <td data-label="标签" class="wrap-cell hide-mobile">
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var tag in bill.Tags)
                                        {
                                            <span class="md-chip md-chip-assist-primary">@tag</span>
                                        }
                                    </div>
                                </td>
                                <td data-label="金额" class="text-right font-medium whitespace-nowrap @(bill.TransactionType == "Income" ? "text-success" : "text-error")">
                                    @(bill.TransactionType == "Income" ? "+" : "-")@bill.Amount.ToString("F2")
                                </td>
                                <td data-label="平台" class="text-center text-on-surface-variant hide-mobile">@bill.PlatformName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 分页 -->
            <div class="flex items-center justify-between gap-2 px-3 sm:px-4 py-3 border-t border-outline-variant">
                <button @onclick="PrevPage" disabled="@(result.Page <= 1)"
                        class="md-btn-outlined state-layer">
                    <span class="material-symbols-outlined mr-1 sm:hidden">chevron_left</span><span class="hidden sm:inline">上一页</span>
                </button>
                <span class="text-body-medium text-on-surface-variant tabular-nums">@result.Page / @((int)Math.Ceiling((double)result.TotalCount / result.PageSize))</span>
                <button @onclick="NextPage" disabled="@(result.Page * result.PageSize >= result.TotalCount)"
                        class="md-btn-outlined state-layer">
                    <span class="hidden sm:inline">下一页</span><span class="material-symbols-outlined ml-1 sm:hidden">chevron_right</span>
                </button>
            </div>
        }
        else
        {
            <div class="empty-state">
                <span class="material-symbols-outlined">receipt_long</span>
                <p>暂无账单数据</p>
                <p class="text-body-medium mt-1">请先 <a href="import" class="text-primary hover:underline">导入对账单</a></p>
            </div>
        }
    </div>
</div>

<!-- 账单详情 / 标签管理弹窗（移动端底部抽屉） -->
@if (detailBill != null)
{
    <div class="modal-root" @onclick="CloseDetail" role="dialog" aria-modal="true" aria-label="账单详情">
        <div class="modal-panel" @onclick:stopPropagation>
            <div class="flex items-start justify-between gap-3 mb-4">
                <div class="min-w-0 flex-1">
                    <h2 class="text-title-large text-on-surface truncate">@detailBill.Merchant</h2>
                    <p class="text-body-medium text-on-surface-variant mt-0.5">@detailBill.TransactionDate.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) · @(detailBill.CategoryName ?? "未分类") · <span class="@(detailBill.TransactionType == "Income" ? "text-success" : "text-error") font-medium">@((detailBill.TransactionType == "Income" ? "+" : "-") + detailBill.Amount.ToString("F2"))</span></p>
                    @if (!string.IsNullOrWhiteSpace(detailBill.ProductName))
                    {
                        <p class="text-body-small text-on-surface-variant mt-0.5 break-words">@detailBill.ProductName</p>
                    }
                </div>
                <button @onclick="CloseDetail" class="md-icon-btn shrink-0" aria-label="关闭">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="mb-4">
                <div class="text-body-medium font-medium text-on-surface mb-2">当前标签</div>
                @if (detailTags == null)
                {
                    <div class="text-body-medium text-on-surface-variant flex items-center gap-2"><span class="md-circular-progress"></span>加载中…</div>
                }
                else if (detailTags.Count == 0)
                {
                    <div class="text-body-medium text-on-surface-variant">暂无标签</div>
                }
                else
                {
                    <div class="flex flex-wrap gap-2">
                        @foreach (var t in detailTags)
                        {
                            <span class="inline-flex items-center gap-1 pl-2.5 pr-1 py-1 rounded-full text-label-small font-medium @(t.Source == "User" ? "bg-primary text-on-primary" : "bg-primary-container text-on-primary-container")">
                                @t.Name
                                <span class="opacity-70 text-[10px]">(@(t.Source == "User" ? "手工" : t.Source == "Rule" ? "规则" : t.Source))</span>
                                <button @onclick="() => RemoveDetailTag(t)" class="inline-flex items-center justify-center rounded-full hover:bg-black/10 active:bg-black/20 transition-colors" style="width:24px;height:24px;" title="移除" aria-label="移除标签 @t.Name">
                                    <span class="material-symbols-outlined" style="font-size:16px;">close</span>
                                </button>
                            </span>
                        }
                    </div>
                }
            </div>

            <div class="flex flex-col sm:flex-row sm:items-end gap-2">
                <div class="flex-1 min-w-0">
                    <label for="addTagSelect" class="block text-body-small text-on-surface-variant mb-1">添加标签（手工）</label>
                    <select id="addTagSelect" @bind="addTagId" class="md-text-field-outlined w-full">
                        <option value="0">— 请选择 —</option>
                        @if (allTags != null)
                        {
                            @foreach (var t in allTags)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        }
                    </select>
                </div>
                <button @onclick="AddDetailTag" disabled="@(addTagId == 0)" class="md-btn-filled state-layer shrink-0 sm:w-auto w-full">添加</button>
            </div>
        </div>
    </div>
}

@code {
    private PagedResult? result;
    private FilterParams filter = new();
    private List<TagOption>? allTags;
    private BillItem? detailBill;
    private List<BillTag>? detailTags;
    private int addTagId;
    private bool initialized;
    private string? appliedQueryKeyword;
    private bool filtersCollapsed = true;

    private int ActiveFilterCount
    {
        get
        {
            var n = 0;
            if (filter.StartDate.HasValue) n++;
            if (filter.EndDate.HasValue) n++;
            if (filter.PlatformId.HasValue) n++;
            if (!string.IsNullOrWhiteSpace(filter.TransactionType)) n++;
            if (!string.IsNullOrWhiteSpace(filter.Keyword)) n++;
            if (filter.TagId.HasValue) n++;
            return n;
        }
    }

    private void ToggleFilters() => filtersCollapsed = !filtersCollapsed;

    /// <summary>支持 /bills?keyword=xxx 直达筛选（商户页"关联账单"跳转）。</summary>
    [SupplyParameterFromQuery(Name = "keyword")]
    public string? QueryKeyword { get; set; }

    private async Task LoadBills()
    {
        try
        {
            var url = $"api/bills?page={filter.Page}&pageSize=20";
            if (filter.StartDate.HasValue) url += $"&startDate={filter.StartDate:yyyy-MM-dd}";
            if (filter.EndDate.HasValue) url += $"&endDate={filter.EndDate:yyyy-MM-dd}";
            if (filter.PlatformId.HasValue) url += $"&platformId={filter.PlatformId}";
            if (!string.IsNullOrWhiteSpace(filter.TransactionType)) url += $"&transactionType={filter.TransactionType}";
            if (!string.IsNullOrWhiteSpace(filter.Keyword)) url += $"&keyword={Uri.EscapeDataString(filter.Keyword)}";
            if (filter.TagId.HasValue) url += $"&tagIds={filter.TagId.Value}";

            result = await Http.GetFromJsonAsync<PagedResult>(url);
        }
        catch { }
    }

    private async Task PrevPage() { if (filter.Page > 1) { filter.Page--; await LoadBills(); } }
    private async Task NextPage() { filter.Page++; await LoadBills(); }

    protected override async Task OnInitializedAsync()
    {
        allTags = await Http.GetFromJsonAsync<List<TagOption>>("api/tags");
        if (!string.IsNullOrWhiteSpace(QueryKeyword)) filter.Keyword = QueryKeyword;
        appliedQueryKeyword = QueryKeyword;
        await LoadBills();
        initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        // 页面存活期间从商户页再次跳转时，同步关键词并重新查询
        if (!initialized || QueryKeyword == appliedQueryKeyword) return;
        appliedQueryKeyword = QueryKeyword;
        filter.Keyword = QueryKeyword;
        filter.Page = 1;
        await LoadBills();
    }

    private async Task OpenDetail(BillItem bill)
    {
        detailBill = bill; addTagId = 0; detailTags = null;
        detailTags = await Http.GetFromJsonAsync<List<BillTag>>($"api/bills/{bill.Id}/tags");
    }
    private void CloseDetail() { detailBill = null; detailTags = null; }

    private async Task AddDetailTag()
    {
        if (detailBill == null || addTagId == 0) return;
        await Http.PostAsJsonAsync($"api/bills/{detailBill.Id}/tags", new { TagId = addTagId });
        addTagId = 0;
        detailTags = await Http.GetFromJsonAsync<List<BillTag>>($"api/bills/{detailBill.Id}/tags");
        await LoadBills();
    }

    private async Task RemoveDetailTag(BillTag t)
    {
        if (detailBill == null) return;
        await Http.DeleteAsync($"api/bills/{detailBill.Id}/tags/{t.TagId}");
        detailTags = await Http.GetFromJsonAsync<List<BillTag>>($"api/bills/{detailBill.Id}/tags");
        await LoadBills();
    }

    private class FilterParams
    {
        public int Page { get; set; } = 1;
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }
        public int? PlatformId { get; set; }
        public string? TransactionType { get; set; }
        public string? Keyword { get; set; }
        public int? TagId { get; set; }
    }

    private record PagedResult(List<BillItem> Items, int TotalCount, int Page, int PageSize);
    private record BillItem(int Id, DateTime TransactionDate, string Counterparty, string Merchant,
        string? CategoryName, int? CategoryId, string ProductName, decimal Amount,
        string TransactionType, string PlatformName, string? FundAccountName, string Status, bool IsManualAdjusted,
        List<string> Tags);
    private record TagOption(int Id, string Name);
    private record BillTag(int TagId, string Name, string Source, double Confidence);
}
