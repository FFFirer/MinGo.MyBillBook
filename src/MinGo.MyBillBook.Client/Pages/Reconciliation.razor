@page "/reconciliation"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>对账中心</PageTitle>
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-800">对账中心</h1>
        <button @onclick="LoadData" class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors">
            <span class="material-icons mr-2">refresh</span>
            刷新
        </button>
    </div>

    @if (errorMessage != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg flex justify-between items-center">
            <span>@errorMessage</span>
            <button @onclick="() => errorMessage = null" class="text-red-500 hover:text-red-700">
                <span class="material-icons text-lg">close</span>
            </button>
        </div>
    }

    @if (infoMessage != null)
    {
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg flex justify-between items-center">
            <span>@infoMessage</span>
            <button @onclick="() => infoMessage = null" class="text-green-500 hover:text-green-700">
                <span class="material-icons text-lg">close</span>
            </button>
        </div>
    }

    <!-- 账户余额对账概览 -->
    <section>
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-lg font-semibold text-gray-700">账户余额对账</h2>
            <button @onclick="OpenSnapshotDialog" class="inline-flex items-center px-3 py-1.5 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors text-sm">
                <span class="material-icons mr-1 text-base">add</span>
                录入银行余额
            </button>
        </div>
        @if (accounts != null)
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200">
                            <th class="text-left py-3 px-4 font-medium text-gray-500">账户</th>
                            <th class="text-right py-3 px-4 font-medium text-gray-500">银行余额</th>
                            <th class="text-right py-3 px-4 font-medium text-gray-500">计算余额</th>
                            <th class="text-right py-3 px-4 font-medium text-gray-500">差异</th>
                            <th class="text-left py-3 px-4 font-medium text-gray-500">快照日期</th>
                            <th class="text-center py-3 px-4 font-medium text-gray-500">状态</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in accounts)
                        {
                            var hasSnap = a.SnapshotDate != null;
                            var diff = a.Difference ?? 0m;
                            <tr class="border-b border-gray-100 hover:bg-gray-50">
                                <td class="py-3 px-4 font-medium">@a.Name</td>
                                <td class="py-3 px-4 text-right text-gray-600">@(hasSnap ? a.BankBalance?.ToString("F2") : "—")</td>
                                <td class="py-3 px-4 text-right text-gray-600">@(hasSnap ? a.CalculatedBalance?.ToString("F2") : "—")</td>
                                <td class="py-3 px-4 text-right font-medium @(Math.Abs(diff) > 0.01m ? "text-red-600" : "text-green-600")">
                                    @(hasSnap ? diff.ToString("F2") : "—")
                                </td>
                                <td class="py-3 px-4 text-gray-500">@(a.SnapshotDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td class="py-3 px-4 text-center">
                                    @if (!hasSnap)
                                    {
                                        <span class="px-2 py-1 rounded-full text-xs bg-gray-100 text-gray-500">未对账</span>
                                    }
                                    else if (Math.Abs(diff) > 0.01m)
                                    {
                                        <span class="px-2 py-1 rounded-full text-xs bg-red-100 text-red-700">有差异</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 rounded-full text-xs bg-green-100 text-green-700">已平账</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <!-- 对账差异清单 -->
    <section>
        <h2 class="text-lg font-semibold text-gray-700 mb-3">对账差异清单</h2>
        @if (issues != null)
        {
            @if (issues.Count == 0)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 text-center text-gray-400">
                    暂无未解决的对账差异
                </div>
            }
            else
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-200">
                                <th class="text-left py-3 px-4 font-medium text-gray-500">账户</th>
                                <th class="text-right py-3 px-4 font-medium text-gray-500">差异</th>
                                <th class="text-left py-3 px-4 font-medium text-gray-500">说明</th>
                                <th class="text-left py-3 px-4 font-medium text-gray-500">创建时间</th>
                                <th class="text-center py-3 px-4 font-medium text-gray-500">状态</th>
                                <th class="text-right py-3 px-4 font-medium text-gray-500">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in issues)
                            {
                                <tr class="border-b border-gray-100 hover:bg-gray-50">
                                    <td class="py-3 px-4 font-medium">@i.AccountName</td>
                                    <td class="py-3 px-4 text-right font-medium text-red-600">@i.Difference.ToString("F2")</td>
                                    <td class="py-3 px-4 text-gray-600">@i.Note</td>
                                    <td class="py-3 px-4 text-gray-500">@i.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="py-3 px-4 text-center">
                                        <span class="px-2 py-1 rounded-full text-xs @(i.Status == "Open" ? "bg-amber-100 text-amber-700" : "bg-green-100 text-green-700")">
                                            @(i.Status == "Open" ? "待处理" : "已解决")
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-right">
                                        @if (i.Status == "Open")
                                        {
                                            <button @onclick="() => ResolveIssue(i)" class="px-3 py-1 text-green-700 bg-green-50 rounded-lg hover:bg-green-100 transition-colors text-xs">
                                                标记已解决
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>

    <!-- 检测到的转账 -->
    <section>
        <h2 class="text-lg font-semibold text-gray-700 mb-3">检测到的转账</h2>
        @if (transfers != null)
        {
            @if (transfers.Count == 0)
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 text-center text-gray-400">
                    暂无检测到的转账记录
                </div>
            }
            else
            {
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-200">
                                <th class="text-left py-3 px-4 font-medium text-gray-500">日期</th>
                                <th class="text-right py-3 px-4 font-medium text-gray-500">金额</th>
                                <th class="text-left py-3 px-4 font-medium text-gray-500">转出账户</th>
                                <th class="text-left py-3 px-4 font-medium text-gray-500">转入账户</th>
                                <th class="text-left py-3 px-4 font-medium text-gray-500">匹配记录</th>
                                <th class="text-center py-3 px-4 font-medium text-gray-500">状态</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in transfers)
                            {
                                <tr class="border-b border-gray-100 hover:bg-gray-50">
                                    <td class="py-3 px-4 text-gray-600">@t.OccurredAt.ToString("yyyy-MM-dd")</td>
                                    <td class="py-3 px-4 text-right font-medium">@t.Amount.ToString("F2")</td>
                                    <td class="py-3 px-4 text-gray-600">@(AccountName(t.FromAccountId))</td>
                                    <td class="py-3 px-4 text-gray-600">@(AccountName(t.ToAccountId))</td>
                                    <td class="py-3 px-4 text-gray-500 text-xs">@t.MatchedRecordIds</td>
                                    <td class="py-3 px-4 text-center">
                                        <span class="px-2 py-1 rounded-full text-xs bg-blue-100 text-blue-700">@TransferStatusName(t.Status)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
</div>

<!-- 录入银行余额弹窗 -->
@if (showSnapshotDialog)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50" @onclick="CloseSnapshotDialog">
        <div class="bg-white rounded-xl shadow-xl p-6 max-w-md w-full mx-4" @onclick:stopPropagation>
            <h2 class="text-lg font-semibold text-gray-800 mb-4">录入银行余额</h2>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">账户</label>
                    <select @bind="formAccountId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
                        <option value="0">请选择账户</option>
                        @if (accounts != null)
                        {
                            @foreach (var a in accounts)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">快照日期</label>
                    <input @bind="formDate" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">银行真实余额（元）</label>
                    <input @bind="formBankBalance" type="number" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" placeholder="0.00" />
                </div>
            </div>
            <div class="flex justify-end gap-3 mt-6">
                <button @onclick="CloseSnapshotDialog" class="px-4 py-2 text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">取消</button>
                <button @onclick="SaveSnapshot" disabled="@isSaving" class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors disabled:opacity-50">
                    @(isSaving ? "保存中..." : "保存并对账")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<AccountReconDto>? accounts;
    private List<IssueDto>? issues;
    private List<TransferDto>? transfers;
    private bool showSnapshotDialog;
    private int formAccountId;
    private DateTime formDate = DateTime.Today;
    private decimal formBankBalance;
    private bool isSaving;
    private string? errorMessage;
    private string? infoMessage;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            accounts = await Http.GetFromJsonAsync<List<AccountReconDto>>("api/reconciliation/accounts");
            issues = await Http.GetFromJsonAsync<List<IssueDto>>("api/reconciliation/issues?openOnly=false");
            transfers = await Http.GetFromJsonAsync<List<TransferDto>>("api/reconciliation/transfers");
        }
        catch (Exception ex)
        {
            errorMessage = $"加载失败：{ex.Message}";
        }
    }

    private void OpenSnapshotDialog()
    {
        formAccountId = accounts?.FirstOrDefault()?.Id ?? 0;
        formDate = DateTime.Today;
        formBankBalance = 0;
        errorMessage = null;
        showSnapshotDialog = true;
    }

    private void CloseSnapshotDialog() => showSnapshotDialog = false;

    private async Task SaveSnapshot()
    {
        if (formAccountId == 0)
        {
            errorMessage = "请选择账户";
            return;
        }
        isSaving = true;
        errorMessage = null;
        try
        {
            var payload = new { accountId = formAccountId, snapshotDate = formDate, bankBalance = formBankBalance };
            var resp = await Http.PostAsJsonAsync("api/reconciliation/snapshots", payload);
            if (resp.IsSuccessStatusCode)
            {
                infoMessage = "银行余额已录入并完成对账";
                showSnapshotDialog = false;
                await LoadData();
            }
            else
            {
                errorMessage = "录入失败";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ResolveIssue(IssueDto issue)
    {
        var resp = await Http.PostAsync($"api/reconciliation/issues/{issue.Id}/resolve", null);
        if (resp.IsSuccessStatusCode)
        {
            infoMessage = "差异已标记为已解决";
            await LoadData();
        }
        else
        {
            errorMessage = "操作失败";
        }
    }

    private string? AccountName(int? id) =>
        id == null ? "—" : accounts?.FirstOrDefault(a => a.Id == id.Value)?.Name ?? $"#{id}";

    private static string TransferStatusName(string status) => status switch
    {
        "Detected" => "已检测",
        "Confirmed" => "已确认",
        "Rejected" => "已排除",
        _ => status
    };

    private record AccountReconDto(int Id, string Name, bool IsActive, decimal? BankBalance, decimal? CalculatedBalance, decimal? Difference, DateTime? SnapshotDate);
    private record IssueDto(int Id, int AccountId, string AccountName, decimal Difference, string Status, string? Note, DateTime CreatedAt, DateTime? ResolvedAt);
    private record TransferDto(int Id, int? FromAccountId, int? ToAccountId, decimal Amount, DateTime OccurredAt, string Status, string MatchedRecordIds);
}
