@page "/reconciliation"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>对账中心</PageTitle>
<div class="space-y-4 sm:space-y-6">
    <div class="page-header">
        <h1>对账中心</h1>
        <div class="actions">
            <button @onclick="LoadData" class="md-btn-tonal state-layer">
                <span class="material-symbols-outlined mr-1 sm:mr-2">refresh</span>
                <span class="hidden xs:inline">刷新</span>
            </button>
        </div>
    </div>

    @if (errorMessage != null)
    {
        <div class="bg-error-container text-on-error-container px-4 py-3 rounded-md flex justify-between items-start gap-3" role="alert">
            <span class="flex-1 text-body-medium break-words">@errorMessage</span>
            <button @onclick="() => errorMessage = null" class="md-icon-btn shrink-0" aria-label="关闭">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }

    @if (infoMessage != null)
    {
        <div class="bg-success-container text-on-success-container px-4 py-3 rounded-md flex justify-between items-start gap-3" role="status">
            <span class="flex-1 text-body-medium break-words">@infoMessage</span>
            <button @onclick="() => infoMessage = null" class="md-icon-btn shrink-0" aria-label="关闭">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
    }

    <!-- 账户余额对账概览 -->
    <section>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
            <h2 class="text-title-medium md:text-title-large text-on-surface">账户余额对账</h2>
            <button @onclick="OpenSnapshotDialog" class="md-btn-filled state-layer sm:w-auto w-full">
                <span class="material-symbols-outlined mr-1">add</span>
                录入银行余额
            </button>
        </div>
        @if (accounts != null)
        {
            <div class="md-card-elevated overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="md-table responsive-cards">
                        <thead>
                            <tr>
                                <th class="text-left">账户</th>
                                <th class="text-right">银行余额</th>
                                <th class="text-right">计算余额</th>
                                <th class="text-right">差异</th>
                                <th class="text-left hide-mobile">快照日期</th>
                                <th class="text-center">状态</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in accounts)
                            {
                                var hasSnap = a.SnapshotDate != null;
                                var diff = a.Difference ?? 0m;
                                <tr>
                                    <td data-label="账户" class="font-medium text-on-surface wrap-cell"><span class="break-words">@a.Name</span></td>
                                    <td data-label="银行余额" class="text-right text-on-surface-variant tabular-nums">@(hasSnap ? a.BankBalance?.ToString("F2") : "—")</td>
                                    <td data-label="计算余额" class="text-right text-on-surface-variant tabular-nums">@(hasSnap ? a.CalculatedBalance?.ToString("F2") : "—")</td>
                                    <td data-label="差异" class="text-right font-medium tabular-nums @(Math.Abs(diff) > 0.01m ? "text-error" : "text-success")">
                                        @(hasSnap ? diff.ToString("F2") : "—")
                                    </td>
                                    <td data-label="快照日期" class="text-on-surface-variant hide-mobile">@(a.SnapshotDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td data-label="状态" class="text-center">
                                        @if (!hasSnap)
                                        {
                                            <span class="md-chip md-chip-assist-info">未对账</span>
                                        }
                                        else if (Math.Abs(diff) > 0.01m)
                                        {
                                            <span class="md-chip md-chip-assist-error">有差异</span>
                                        }
                                        else
                                        {
                                            <span class="md-chip md-chip-assist-success">已平账</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>

    <!-- 对账差异清单 -->
    <section>
        <h2 class="text-title-medium md:text-title-large text-on-surface mb-3">对账差异清单</h2>
        @if (issues != null)
        {
            @if (issues.Count == 0)
            {
                <div class="md-card-elevated p-6 text-center text-on-surface-variant empty-state">
                    <span class="material-symbols-outlined text-success">check_circle</span>
                    暂无未解决的对账差异
                </div>
            }
            else
            {
                <div class="md-card-elevated overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="md-table responsive-cards">
                            <thead>
                                <tr>
                                    <th class="text-left">账户</th>
                                    <th class="text-right">差异</th>
                                    <th class="text-left hide-mobile">说明</th>
                                    <th class="text-left hide-mobile">创建时间</th>
                                    <th class="text-center">状态</th>
                                    <th class="text-right">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in issues)
                                {
                                    <tr>
                                        <td data-label="账户" class="font-medium text-on-surface wrap-cell"><span class="break-words">@i.AccountName</span></td>
                                        <td data-label="差异" class="text-right font-medium text-error tabular-nums">@i.Difference.ToString("F2")</td>
                                        <td data-label="说明" class="text-on-surface-variant wrap-cell hide-mobile"><span class="break-words">@i.Note</span></td>
                                        <td data-label="创建时间" class="text-on-surface-variant hide-mobile">@i.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td data-label="状态" class="text-center">
                                            <span class="md-chip @(i.Status == "Open" ? "md-chip-assist-warning" : "md-chip-assist-success")">
                                                @(i.Status == "Open" ? "待处理" : "已解决")
                                            </span>
                                        </td>
                                        <td data-label="操作" class="text-right">
                                            @if (i.Status == "Open")
                                            {
                                                <button @onclick="() => ResolveIssue(i)" class="md-btn-text state-layer">
                                                    标记已解决
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </section>

    <!-- 检测到的转账 -->
    <section>
        <h2 class="text-title-medium md:text-title-large text-on-surface mb-3">检测到的转账</h2>
        @if (transfers != null)
        {
            @if (transfers.Count == 0)
            {
                <div class="md-card-elevated p-6 text-center text-on-surface-variant empty-state">
                    <span class="material-symbols-outlined">swap_horiz</span>
                    暂无检测到的转账记录
                </div>
            }
            else
            {
                <div class="md-card-elevated overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="md-table responsive-cards">
                            <thead>
                                <tr>
                                    <th class="text-left">日期</th>
                                    <th class="text-right">金额</th>
                                    <th class="text-left">转出账户</th>
                                    <th class="text-left">转入账户</th>
                                    <th class="text-left hide-mobile">匹配记录</th>
                                    <th class="text-center hide-mobile">状态</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in transfers)
                                {
                                    <tr>
                                        <td data-label="日期" class="text-on-surface-variant">@t.OccurredAt.ToString("yyyy-MM-dd")</td>
                                        <td data-label="金额" class="text-right font-medium tabular-nums text-on-surface">@t.Amount.ToString("F2")</td>
                                        <td data-label="转出账户" class="text-on-surface-variant wrap-cell"><span class="break-words">@(AccountName(t.FromAccountId))</span></td>
                                        <td data-label="转入账户" class="text-on-surface-variant wrap-cell"><span class="break-words">@(AccountName(t.ToAccountId))</span></td>
                                        <td data-label="匹配记录" class="text-on-surface-variant text-body-small wrap-cell hide-mobile"><span class="break-all">@t.MatchedRecordIds</span></td>
                                        <td data-label="状态" class="text-center hide-mobile">
                                            <span class="md-chip md-chip-assist-info">@TransferStatusName(t.Status)</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </section>
</div>

<!-- 录入银行余额弹窗 -->
@if (showSnapshotDialog)
{
    <div class="modal-root" @onclick="CloseSnapshotDialog" role="dialog" aria-modal="true" aria-label="录入银行余额">
        <div class="modal-panel modal-sm" @onclick:stopPropagation>
            <h2 class="text-title-large text-on-surface mb-4">录入银行余额</h2>
            <div class="space-y-4">
                <div>
                    <label for="snapAccountSelect" class="block text-body-small text-on-surface-variant mb-1">账户</label>
                    <select id="snapAccountSelect" @bind="formAccountId" class="md-text-field-outlined w-full">
                        <option value="0">请选择账户</option>
                        @if (accounts != null)
                        {
                            @foreach (var a in accounts)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label for="snapDateInput" class="block text-body-small text-on-surface-variant mb-1">快照日期</label>
                    <input id="snapDateInput" @bind="formDate" type="date" class="md-text-field-outlined w-full" />
                </div>
                <div>
                    <label for="snapBalanceInput" class="block text-body-small text-on-surface-variant mb-1">银行真实余额（元）</label>
                    <input id="snapBalanceInput" @bind="formBankBalance" type="number" step="0.01" inputmode="decimal" class="md-text-field-outlined w-full" placeholder="0.00" />
                </div>
            </div>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3 mt-6">
                <button @onclick="CloseSnapshotDialog" class="md-btn-outlined state-layer w-full sm:w-auto">取消</button>
                <button @onclick="SaveSnapshot" disabled="@isSaving" class="md-btn-filled state-layer w-full sm:w-auto">
                    @(isSaving ? "保存中…" : "保存并对账")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<AccountReconDto>? accounts;
    private List<IssueDto>? issues;
    private List<TransferDto>? transfers;
    private bool showSnapshotDialog;
    private int formAccountId;
    private DateTime formDate = DateTime.Today;
    private decimal formBankBalance;
    private bool isSaving;
    private string? errorMessage;
    private string? infoMessage;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            accounts = await Http.GetFromJsonAsync<List<AccountReconDto>>("api/reconciliation/accounts");
            issues = await Http.GetFromJsonAsync<List<IssueDto>>("api/reconciliation/issues?openOnly=false");
            transfers = await Http.GetFromJsonAsync<List<TransferDto>>("api/reconciliation/transfers");
        }
        catch (Exception ex)
        {
            errorMessage = $"加载失败：{ex.Message}";
        }
    }

    private void OpenSnapshotDialog()
    {
        formAccountId = accounts?.FirstOrDefault()?.Id ?? 0;
        formDate = DateTime.Today;
        formBankBalance = 0;
        errorMessage = null;
        showSnapshotDialog = true;
    }

    private void CloseSnapshotDialog() => showSnapshotDialog = false;

    private async Task SaveSnapshot()
    {
        if (formAccountId == 0)
        {
            errorMessage = "请选择账户";
            return;
        }
        isSaving = true;
        errorMessage = null;
        try
        {
            var payload = new { accountId = formAccountId, snapshotDate = formDate, bankBalance = formBankBalance };
            var resp = await Http.PostAsJsonAsync("api/reconciliation/snapshots", payload);
            if (resp.IsSuccessStatusCode)
            {
                infoMessage = "银行余额已录入并完成对账";
                showSnapshotDialog = false;
                await LoadData();
            }
            else
            {
                errorMessage = "录入失败";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ResolveIssue(IssueDto issue)
    {
        var resp = await Http.PostAsync($"api/reconciliation/issues/{issue.Id}/resolve", null);
        if (resp.IsSuccessStatusCode)
        {
            infoMessage = "差异已标记为已解决";
            await LoadData();
        }
        else
        {
            errorMessage = "操作失败";
        }
    }

    private string? AccountName(int? id) =>
        id == null ? "—" : accounts?.FirstOrDefault(a => a.Id == id.Value)?.Name ?? $"#{id}";

    private static string TransferStatusName(string status) => status switch
    {
        "Detected" => "已检测",
        "Confirmed" => "已确认",
        "Rejected" => "已排除",
        _ => status
    };

    private record AccountReconDto(int Id, string Name, bool IsActive, decimal? BankBalance, decimal? CalculatedBalance, decimal? Difference, DateTime? SnapshotDate);
    private record IssueDto(int Id, int AccountId, string AccountName, decimal Difference, string Status, string? Note, DateTime CreatedAt, DateTime? ResolvedAt);
    private record TransferDto(int Id, int? FromAccountId, int? ToAccountId, decimal Amount, DateTime OccurredAt, string Status, string MatchedRecordIds);
}
