<ModalDialog Visible="@Visible" OnClose="@OnCancel" Size="sm" Role="alertdialog" AriaLabel="@($"确认删除{EntityType}")">
    <h2 class="text-title-large text-on-surface mb-2">确认删除</h2>
    <p class="text-body-medium text-on-surface-variant mb-6">
        确定要删除@(!string.IsNullOrEmpty(EntityType) ? EntityType : "项目")「<span class="font-medium text-on-surface">@ItemName</span>」吗？此操作不可撤销。
    </p>
    <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 sm:gap-3">
        <button @onclick="OnCancel" class="md-btn-outlined w-full sm:w-auto">取消</button>
        <button @onclick="OnConfirm" class="md-btn-danger w-full sm:w-auto">确认删除</button>
    </div>
</ModalDialog>

@code {
    /// <summary>Whether the dialog is visible.</summary>
    [Parameter] public bool Visible { get; set; }

    /// <summary>The name of the item being deleted (shown in the message).</summary>
    [Parameter] public string ItemName { get; set; } = "";

    /// <summary>The entity type label (e.g. "账户", "分类", "规则").</summary>
    [Parameter] public string EntityType { get; set; } = "";

    /// <summary>Called when the user cancels.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Called when the user confirms the deletion.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }
}
