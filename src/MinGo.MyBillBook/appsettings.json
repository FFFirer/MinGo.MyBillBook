{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=mybillbook.db"
  },
  "ObjectStorage": {
    "Provider": "Local",
    "Local": {
      "BasePath": "data/storage"
    }
  },
  "Inbox": {
    "WorkflowsPath": "data/inboxes",
    "WorkspacePath": "data/inbox-workspace",
    "PollSeconds": 2,
    "WorkspaceRetentionDays": 30,
    "WorkspaceMaxRuns": 200,
    "CleanupIntervalHours": 6,
    "Secrets": {
    },
    "EmailAccounts": {
    }
  }
}
